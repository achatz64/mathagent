import classical_propositional_logic

-- Classical first-order logic, built on the classical propositions of
-- classical_propositional_logic.cor (the universe PC = Prop). Quantifiers are the
-- reason Core needs dependent types: "∀ x : X, P x" is the dependent function type
-- (x : X) → P x landing in PC.

-- fibration: a predicate over a domain X is a propositional function X → PC.
abbrev Pred (X : Type) := X → PC

-- universal quantifier: Forall X P is "∀ x : X, P x"
axiom Forall (X : Type) (P : Pred X) : PC
-- intro: a proof of P x for every x (a dependent function) proves Forall X P
axiom Forall_intro (X : Type) (P : Pred X) : ((x : X) → P x) → Forall X P
-- elim: from Forall X P and any x : X, get a proof of P x
axiom Forall_elim (X : Type) (P : Pred X) : Forall X P → (x : X) → P x

-- existential quantifier: Exist X P is "∃ x : X, P x"
axiom Exist (X : Type) (P : Pred X) : PC
-- intro: a witness x : X together with a proof of P x proves Exist X P
axiom Exist_intro (X : Type) (P : Pred X) : (x : X) → P x → Exist X P
-- elim: to conclude Q from Exist X P, prove Q from an arbitrary witness and proof
axiom Exist_elim (X : Type) (P : Pred X) (Q : PC) : ((x : X) → P x → Q) → Exist X P → Q
