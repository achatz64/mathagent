// Types

Classes can be defined, see below. Each class is a type.
For two types X, Y, we can construct a new type X -> Y (imagine X -> Y as maps/functions from X to Y). 

Example: let X, Y, Z be classes. We can build (X -> Y) -> Z and X -> (Y -> Z). 

Convention: for types X, Y, Z, X -> Y -> Z means X -> (Y -> Z). 

Note that we can naturally convert, for example X -> (Y -> Z) can be converted to Y -> (X -> Z). In terms of fuctions: given f: X -> (Y -> Z) define g: Y -> (X -> Z) by g(y)(x)=f(x)(y).  

// Classes

// A class has an interface and a condition statement. 
// The interface is a dictionary of function signatures. 
// The condition follows a well-typed syntax involving `forall`, `exist` and `exist!` (exists and is unique). We can write auxilary code in the class definition to make the condition statements more readable.

// this is a toy example 
class Boolean {
    interface {
        const true: Boolean
        const false: Boolean
    }
    const cond only_elements {
        forall b: Boolean { b = true or b = false}
    }

    cond cond difference {
        not { true = false } 
    }

    condition {
        only_elements and difference
    }
}

// most basic class of objects, no structure
class Objects {}

// we need to be able to use terms of terms and thats why we assign them a type
class S {
    // sup means we can give `forall s: S forall x: s`, in this example all s belong to class Objects/have type Objects 
    // is sup sufficient in general? 
    sup Objects 
}

// we can define Abelian groups here with respect to S
class Abelian {
    interface {
        const under: S
        const 0: self.under // self.under is a term in S, and terms of self.under are defined for S
        add: self.under -> self.under -> self.under  
        inverse: self.under -> self.under
    }

    // associativity
    const cond associative {
        forall x,y,z: self.under add(x, add(y, z)) = add(add(x, y), z)
    }
    // other conditions omited
    ...
    
    condition {
        associative and ...
    }
}

// Natural numbers 
class N {
    interface {
        const 0: N
        next: N -> N
    }

    // use of cond not great, maybe prop (from proposition) or state (from statement) better?

    // Peano axioms
    const cond next_properties  {
        {forall n: N  n=0 or {exist m: N next(m)=n}} 
        and  
        {forall n,m: N next(n) = next(m) => n = m}
    }

    // induction on statement
    // we decided to use generics and avoid dependent type theory for now, P can be any type 
    const cond induction<P> 
        {
            forall f: N -> (P -> B) {
                {
                    { forall p: P f(0)(p) } 
                    and 
                    forall n: N {forall p: P f(n)(p) => forall p: P f(next(n))(p)}
                }
                => forall n: N forall p: P f(n)(p)
            }
        } 
    // we can abbreviate total reduction with for all operator to Boolean with `holds`
    const cond induction_with_holds<P>  {
        forall f: N -> (P -> B) {
            {
                holds f(0) 
                and 
                forall n: N {holds f(n) =>  holds f(next(n))}
            }
            => holds f 
        }
    }    

    // easier?, notice that in cond the types of the arguments can depend on each other  
    cond induction_start<P>(f: N -> (P -> B))  {
        forall p: P f(0)(p)
    } 
    cond induction_step<P>(f: N -> (P -> B))  {
        forall n: N {
            {forall p: P f(n)(p)} => {forall p: P f(next(n))(p)}
        }
    } 
    cond induction_statement<P>(f: N -> (P -> B)) {
        forall n: N forall p: P f(n)(p) 
    }
    
    const cond induction_alternative<P> {
        forall f: N -> (P -> B) 
            {induction_start(f) and induction_step(f)} => induction_statement(f)
    }

    const cond inductive_definition<P> {
        forall p: P forall g: N -> P -> P exist! f: N -> P {
            {f(0) = p} and { f(next(n)) = g(n)(f(n)) } 
        }    
    } 

    // can induction_definition be proved from induction? i don't see how.
    condition {
        next_properties and induction and inductive_definition 
    } 
}


// normal source code in file example: show that addition exists for N, that is add: N -> N -> N.
let id: N -> N = {fn (n: N) {n}}

theorem there_is_add {
    statement: {   
        N.condition => {
            exist! add: N -> N -> N 
            {add(0) = id} and {forall n: N add(n)(0) = n} and {forall n, m: N f(N.next(n))(m) = N.next(f(n)(m)) and f(n)(N.next(m)) = N.next(f(n)(m))}   
        } 
    }
    proof: {
        // all `by proof` is handwaving and syntax is unclear/undefined, we must use some inspiration from first/second order calculus 
        have N.inductive_definition by proof {N.condition => N.inductive_definition;} 
        have add, add_condition = {
            let P = N -> N;
            let p: P = id;
            let g: N -> P -> P = fn (n: N, p: P) { fn (m: N) { N.next(p(m)) }}; 
            have exist! f: N -> P by proof {N.induction_definition<P>(p, g);}
        }
        have add(0) = id by proof { add_condition => add(0) = id;};
        let c = fn(n) {add(n)(0) = n};
        have c(0) by proof {
           add(0) = id => add(0)(0) = id(0);
           add(0)(0) = id(0) and id(0) = 0 => add(0)(0) = 0;
           add(0)(0) = 0 => c(0);       
        }
        // by proof is handwaving, use first order calculus 
        have forall n: N  c(n) => c(N.next(n)) by proof {
            add_condition => add(N.next(n))(0) = N.next(add(n)(0));
            c(n) => add(n)(0) = n;
            add(N.next(n))(0) = N.next(add(n)(0)) and add(n)(0) = n => add(N.next(n))(0) = N.next(n) => c(N.next(n)); 
        }
        have N.induction by proof {N.condition => N.induction;}
        have forall n: N c(n) by proof {
            N.induction<Singleton> => forall n: N c(n);
        }
           
        have forall n: N add(n)(0) = n by proof {
            forall n: N c(n) => forall n: N add(n)(0) = n;
        }

        // to be continued, still `forall n, m: N f(N.next(n))(m) = N.next(f(n)(m)) and f(n)(N.next(m)) = N.next(f(n)(m))` is missing
    }
}

// General construction of new arrows X -> Y
// 1. We can use `forall x: X exist! y: Y something => exist! f: X -> Y forall x: X something_new` where y in something_new is replaced by f(x) and f does not appear in something (replace f with something else otherwise)
// 2. Patching: We can split X into disjoint conditions: 
//    {forall x: X {Q(x) or P(x)} and not {Q(x) and P(x)}} => {
//      forall P: class forall f, g: X -> P exist! h: X -> P forall x: X {
//          {h(x) = f(x) and Q(x)} or {h(x) = g(x) and P(x)}
//      }   
//    }
//    This example also shows it totally makes sense to use the same variable bounded differently in the same statement.

// As example for patching we can take the class Boolean and define `and` and `or`.  

// Main abstraction. 
class Class {
    sup Class 
    interface {
        const B: Class // short for Boolean
        // use generics, more expressible in general to put structures on terms.  And automatic/implicit conversion in the background to formulate statements. 
        forall<X: Class, T: Class>: (X -> (T -> B)) -> (T -> B)
        exist<X: Class, T: Class>: (X -> (T -> B)) -> (T -> B)
    }

    // Boolean conditions need to be described 
}  

