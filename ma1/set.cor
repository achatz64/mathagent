import classical_first_order_logic_new
import cartesian_combinators

-- Sets and the ZFC axioms, in the new-style HOL of classical_first_order_logic_new.cor.
--
-- Quantifiers are the predicate-valued `Forall`/`Exist`: a formula with free variables
-- is a `Pred` over a right-nested product *context* (the free-variable tuple); a closed
-- sentence is a `Pred Final`, shipped to `Prop` by `Pred.term`. Nothing is lambda-lifted:
-- every relation is a `Pred` on a product of its argument sorts, every occurrence is
-- `sub2 R π₁ π₂` (reindex along the de-Bruijn projections `v0..v3` of prod.cor), schematic
-- parameters enter as `Cart.weakening` constants, and every def is applied to all its args.

-- the universe of sets: a set is a term `S : Sets`.
axiom Sets : Type

-- global membership relation:  elem x A = "x ∈ A"  (named elem; `in` is a Lean keyword)
axiom elem : Sets → Sets → PC

-- membership as a binary predicate on pairs:  Elem (x, A) = x ∈ A
def Elem : Pred (Sets × Sets) := uncurry Sets Sets PC elem

-- ===== derived relations (new style) =====

-- x nonempty : ∃w. w ∈ x         ctx = x
def SetNonempty : Pred Sets := Exist Sets Sets Elem

-- Subset (a,b) : ∀x. x∈a → x∈b    inner tuple (x,(a,b)) : Sets×(Sets×Sets)
def Subseteq : Pred (Sets × Sets) :=
  Forall Sets (Sets × Sets)
    (Pred.imply (Sets × (Sets × Sets))
      (sub2 (Sets × (Sets × Sets)) Sets Sets Elem (v0 Sets (Sets × Sets)) (v1 Sets Sets Sets))
      (sub2 (Sets × (Sets × Sets)) Sets Sets Elem (v0 Sets (Sets × Sets)) ((snd Sets Sets) ∘ (snd Sets (Sets × Sets)))))

-- SetEq (a,b) : ∀x. x∈a ↔ x∈b   —  the instance `RelEq Sets Elem` of the generic
-- extensional-equality-of-a-relation construct (classical_first_order_logic_new.cor).
def SetEq : Pred (Sets × Sets) := RelEq Sets Elem

-- isEmpty (e) : ∀z. ¬(z∈e)        Elem : (z,e) ↦ z∈e
def isEmpty : Pred Sets := Forall Sets Sets (Pred.not (Sets × Sets) Elem)

-- isSucc (x,y) : ∀z. z∈y ↔ (z∈x ∨ z=x)   inner tuple (z,(x,y)) : Sets×(Sets×Sets)
def isSucc : Pred (Sets × Sets) :=
  Forall Sets (Sets × Sets)
    (Pred.iff (Sets × (Sets × Sets))
      (sub2 (Sets × (Sets × Sets)) Sets Sets Elem (v0 Sets (Sets × Sets)) ((snd Sets Sets) ∘ (snd Sets (Sets × Sets))))
      (Pred.or (Sets × (Sets × Sets))
        (sub2 (Sets × (Sets × Sets)) Sets Sets Elem (v0 Sets (Sets × Sets)) (v1 Sets Sets Sets))
        (sub2 (Sets × (Sets × Sets)) Sets Sets SetEq (v0 Sets (Sets × Sets)) (v1 Sets Sets Sets))))

-- x,y disjoint : ¬∃z. (z∈x ∧ z∈y)   inner tuple (z,(x,y))
def disj : Pred (Sets × Sets) :=
  Pred.not (Sets × Sets)
    (Exist Sets (Sets × Sets)
      (Pred.and (Sets × (Sets × Sets))
        (sub2 (Sets × (Sets × Sets)) Sets Sets Elem (v0 Sets (Sets × Sets)) (v1 Sets Sets Sets))
        (sub2 (Sets × (Sets × Sets)) Sets Sets Elem (v0 Sets (Sets × Sets)) ((snd Sets Sets) ∘ (snd Sets (Sets × Sets))))))

-- ===== axioms =====

-- ===== the one equality primitive: ∈-left (member-slot) congruence, "extension to the right" =====
-- SetEq is DEFINED extensionally (∀x. x∈a ↔ x∈b), so its reflexivity, symmetry, transitivity and
-- CONTAINER-slot substitution (x∈a ⊢ x∈b) are all DERIVED (see set_equality.cor) from that
-- definition plus the logic layer.  The one fact INDEPENDENT of the definition is congruence in the
-- MEMBER slot — extensionally equal sets belong to the same sets:  a=b → (a∈z ↔ b∈z), i.e. SetEq
-- "extended to the right", ∀z. a∈z ↔ b∈z.
--
-- It is consumed UNDER quantifier binders (the ∃/∀ over the infinity witness), where the equal set
-- is a BOUND variable.  A point-wise axiom `(a b z) → …` cannot be instantiated at a bound variable
-- (no dependent types), so this MUST be an OBJECT-∀ statement, internalized over the MEMBER slot,
-- with the equal partner `b` and the container `z` as parameters:
--   ∀a. ( SetEq(a,b) → (a∈z ↔ b∈z) ).
-- MODEL: extensionally equal a, b are the SAME object, so belong to the same z; valid at every a.
-- The point-wise congruence is the `Forall_elim` instance (see set_equality.cor `mem_subst_left`);
-- this object-∀ form is the one binders can use.  (Supersedes the old point-wise `memCong_left`.)
def memCongBody (b z : Sets) : Pred (Sets × Final) :=
  Pred.imply (Sets × Final)
    (sub2 (Sets × Final) Sets Sets SetEq (v0 Sets Final) (Cart.weakening Sets (Sets × Final) b))
    (Pred.iff (Sets × Final)
      (sub2 (Sets × Final) Sets Sets Elem (v0 Sets Final) (Cart.weakening Sets (Sets × Final) z))
      (sub2 (Sets × Final) Sets Sets Elem
        (Cart.weakening Sets (Sets × Final) b) (Cart.weakening Sets (Sets × Final) z)))

axiom memCong_left_all (b z : Sets) :
  Pred.term (Forall Sets Final (memCongBody b z))

-- Pairing.  ∃c. ∀x. (x∈c ↔ x=a ∨ x=b)     ctx after ∀x: (x,(c,⋆)) : Sets×(Sets×Final)
axiom pairing (a b : Sets) :
  Pred.term (Exist Sets Final (Forall Sets (Sets × Final)
    (Pred.iff (Sets × (Sets × Final))
      (sub2 (Sets × (Sets × Final)) Sets Sets Elem (v0 Sets (Sets × Final)) (v1 Sets Sets Final))
      (Pred.or (Sets × (Sets × Final))
        (sub2 (Sets × (Sets × Final)) Sets Sets SetEq (v0 Sets (Sets × Final)) (Cart.weakening Sets (Sets × (Sets × Final)) a))
        (sub2 (Sets × (Sets × Final)) Sets Sets SetEq (v0 Sets (Sets × Final)) (Cart.weakening Sets (Sets × (Sets × Final)) b))))))

-- Union.  ∃U. ∀x. (x∈U ↔ ∃y. (y∈A ∧ x∈y))
-- ∀x tuple (x,(U,⋆)) : Sets×(Sets×Final);  ∃y tuple (y,(x,(U,⋆))) : Sets×(Sets×(Sets×Final))
axiom union_ax (A : Sets) :
  Pred.term (Exist Sets Final (Forall Sets (Sets × Final)
    (Pred.iff (Sets × (Sets × Final))
      (sub2 (Sets × (Sets × Final)) Sets Sets Elem (v0 Sets (Sets × Final)) (v1 Sets Sets Final))
      (Exist Sets (Sets × (Sets × Final))
        (Pred.and (Sets × (Sets × (Sets × Final)))
          (sub2 (Sets × (Sets × (Sets × Final))) Sets Sets Elem
            (v0 Sets (Sets × (Sets × Final))) (Cart.weakening Sets (Sets × (Sets × (Sets × Final))) A))
          (sub2 (Sets × (Sets × (Sets × Final))) Sets Sets Elem
            (v1 Sets Sets (Sets × Final)) (v0 Sets (Sets × (Sets × Final)))))))))

-- Power set.  ∃P. ∀x. (x∈P ↔ x⊆A)      ∀x tuple (x,(P,⋆))
axiom power_ax (A : Sets) :
  Pred.term (Exist Sets Final (Forall Sets (Sets × Final)
    (Pred.iff (Sets × (Sets × Final))
      (sub2 (Sets × (Sets × Final)) Sets Sets Elem (v0 Sets (Sets × Final)) (v1 Sets Sets Final))
      (sub2 (Sets × (Sets × Final)) Sets Sets Subseteq
        (v0 Sets (Sets × Final)) (Cart.weakening Sets (Sets × (Sets × Final)) A)))))

-- Separation (schema in φ).  ∃B. ∀x. (x∈B ↔ (x∈A ∧ φ x))
axiom separation (A : Sets) (phi : Pred Sets) :
  Pred.term (Exist Sets Final (Forall Sets (Sets × Final)
    (Pred.iff (Sets × (Sets × Final))
      (sub2 (Sets × (Sets × Final)) Sets Sets Elem (v0 Sets (Sets × Final)) (v1 Sets Sets Final))
      (Pred.and (Sets × (Sets × Final))
        (sub2 (Sets × (Sets × Final)) Sets Sets Elem (v0 Sets (Sets × Final)) (Cart.weakening Sets (Sets × (Sets × Final)) A))
        (phi ∘ (v0 Sets (Sets × Final)))))))

-- Empty set.  ∃e. isEmpty e
axiom empty_ax : Pred.term (Exist Sets Final (isEmpty ∘ (v0 Sets Final)))

-- Infinity.  An inductive set contains an empty set and is closed under successor:
--   infBody I  :  ∃e.(e∈I ∧ isEmpty e)  ∧  ∀x.(x∈I → ∃y.(y∈I ∧ isSucc x y))
-- ctx: (I,⋆); ∃e:(e,(I,⋆)); ∀x:(x,(I,⋆)); ∃y:(y,(x,(I,⋆)))
def infBody : Pred (Sets × Final) :=
  Pred.and (Sets × Final)
    -- ∃e. e∈I ∧ isEmpty e
    (Exist Sets (Sets × Final)
      (Pred.and (Sets × (Sets × Final))
        (sub2 (Sets × (Sets × Final)) Sets Sets Elem (v0 Sets (Sets × Final)) (v1 Sets Sets Final))
        (isEmpty ∘ (v0 Sets (Sets × Final)))))
    -- ∀x. x∈I → ∃y. (y∈I ∧ isSucc x y)
    (Forall Sets (Sets × Final)
      (Pred.imply (Sets × (Sets × Final))
        (sub2 (Sets × (Sets × Final)) Sets Sets Elem (v0 Sets (Sets × Final)) (v1 Sets Sets Final))
        (Exist Sets (Sets × (Sets × Final))
          (Pred.and (Sets × (Sets × (Sets × Final)))
            (sub2 (Sets × (Sets × (Sets × Final))) Sets Sets Elem
              (v0 Sets (Sets × (Sets × Final))) (v2 Sets Sets Sets Final))
            (sub2 (Sets × (Sets × (Sets × Final))) Sets Sets isSucc
              (v1 Sets Sets (Sets × Final)) (v0 Sets (Sets × (Sets × Final))))))))

-- Axiom of Infinity, Skolemized: postulate ONE concrete infinite (inductive) set `Inf`.
-- Inductive sets are not unique, so we cannot describe one with `the`; we postulate a named
-- witness here (the home for set axioms) instead of eliminating a bare `∃I`.  ω is then carved
-- out of `Inf` by Separation (which IS unique) in natural_numbers_zf.cor.
axiom Inf : Sets
axiom Inf_spec : Pred.term (inst Sets infBody Inf)

-- Regularity.  imply (Nonempty x) (∃y. (y∈x ∧ ¬∃z.(z∈y ∧ z∈x)))
-- ∃y:(y,⋆); ∃z:(z,(y,⋆))
axiom regularity (x : Sets) :
  imply (SetNonempty x)
    (Pred.term (Exist Sets Final
      (Pred.and (Sets × Final)
        (sub2 (Sets × Final) Sets Sets Elem (v0 Sets Final) (Cart.weakening Sets (Sets × Final) x))
        (Pred.not (Sets × Final)
          (Exist Sets (Sets × Final)
            (Pred.and (Sets × (Sets × Final))
              (sub2 (Sets × (Sets × Final)) Sets Sets Elem (v0 Sets (Sets × Final)) (v1 Sets Sets Final))
              (sub2 (Sets × (Sets × Final)) Sets Sets Elem (v0 Sets (Sets × Final)) (Cart.weakening Sets (Sets × (Sets × Final)) x))))))))

-- Replacement (schema in φ : Sets → Sets → PC).
-- premise ∀x. x∈A → ∃!y φ(x,y) ;  image ∃B. ∀y. (y∈B ↔ ∃x. (x∈A ∧ φ(x,y)))
-- ∃! y φ  ≡  ∃y. (φ(x,y) ∧ ∀z. (φ(x,z) → z=y))
def replUniq (phi : Sets → Sets → PC) : Pred (Sets × (Sets × (Sets × Final))) :=
  Pred.imply _
    (sub2 _ Sets Sets (uncurry Sets Sets PC phi) (v2 Sets Sets Sets Final) (v0 Sets (Sets × (Sets × Final))))
    (sub2 _ Sets Sets SetEq (v0 Sets (Sets × (Sets × Final))) (v1 Sets Sets (Sets × Final)))

def replExU (phi : Sets → Sets → PC) : Pred (Sets × (Sets × Final)) :=
  Pred.and _
    (sub2 _ Sets Sets (uncurry Sets Sets PC phi) (v1 Sets Sets Final) (v0 Sets (Sets × Final)))
    (Forall Sets _ (replUniq phi))

def replFun (A : Sets) (phi : Sets → Sets → PC) : Pred (Sets × Final) :=
  Pred.imply _
    (sub2 _ Sets Sets Elem (v0 Sets Final) (Cart.weakening Sets (Sets × Final) A))
    (Exist Sets _ (replExU phi))

def replWit (A : Sets) (phi : Sets → Sets → PC) : Pred (Sets × (Sets × (Sets × Final))) :=
  Pred.and _
    (sub2 _ Sets Sets Elem (v0 Sets (Sets × (Sets × Final))) (Cart.weakening Sets (Sets × (Sets × (Sets × Final))) A))
    (sub2 _ Sets Sets (uncurry Sets Sets PC phi) (v0 Sets (Sets × (Sets × Final))) (v1 Sets Sets (Sets × Final)))

def replBody (A : Sets) (phi : Sets → Sets → PC) : Pred (Sets × (Sets × Final)) :=
  Pred.iff _
    (sub2 _ Sets Sets Elem (v0 Sets (Sets × Final)) (v1 Sets Sets Final))
    (Exist Sets _ (replWit A phi))

axiom replacement (A : Sets) (phi : Sets → Sets → PC) :
  imply
    (Pred.term (Forall Sets Final (replFun A phi)))
    (Pred.term (Exist Sets Final (Forall Sets (Sets × Final) (replBody A phi))))

-- Choice (schema in F).
-- premise ∀x∈F. (x nonempty ∧ ∀y∈F. (x=y ∨ x,y disjoint))
-- image   ∃C. ∀x∈F. ∃!w. (w∈x ∧ w∈C)
def chPairwise (F : Sets) : Pred (Sets × (Sets × Final)) :=
  Pred.imply _
    (sub2 _ Sets Sets Elem (v0 Sets (Sets × Final)) (Cart.weakening Sets (Sets × (Sets × Final)) F))
    (Pred.or _
      (sub2 _ Sets Sets SetEq (v1 Sets Sets Final) (v0 Sets (Sets × Final)))
      (sub2 _ Sets Sets disj (v1 Sets Sets Final) (v0 Sets (Sets × Final))))

def chMember (F : Sets) : Pred (Sets × Final) :=
  Pred.imply _
    (sub2 _ Sets Sets Elem (v0 Sets Final) (Cart.weakening Sets (Sets × Final) F))
    (Pred.and _
      (SetNonempty ∘ (v0 Sets Final))
      (Forall Sets _ (chPairwise F)))

def chUniq : Pred (Sets × (Sets × (Sets × (Sets × Final)))) :=
  Pred.imply _
    (Pred.and _
      (sub2 _ Sets Sets Elem (v0 Sets (Sets × (Sets × (Sets × Final)))) (v2 Sets Sets Sets (Sets × Final)))
      (sub2 _ Sets Sets Elem (v0 Sets (Sets × (Sets × (Sets × Final)))) (v3 Sets Sets Sets Sets Final)))
    (sub2 _ Sets Sets SetEq (v0 Sets (Sets × (Sets × (Sets × Final)))) (v1 Sets Sets (Sets × (Sets × Final))))

def chExU : Pred (Sets × (Sets × (Sets × Final))) :=
  Pred.and _
    (Pred.and _
      (sub2 _ Sets Sets Elem (v0 Sets (Sets × (Sets × Final))) (v1 Sets Sets (Sets × Final)))
      (sub2 _ Sets Sets Elem (v0 Sets (Sets × (Sets × Final))) (v2 Sets Sets Sets Final)))
    (Forall Sets _ chUniq)

def chChoose (F : Sets) : Pred (Sets × (Sets × Final)) :=
  Pred.imply _
    (sub2 _ Sets Sets Elem (v0 Sets (Sets × Final)) (Cart.weakening Sets (Sets × (Sets × Final)) F))
    (Exist Sets _ chExU)

axiom choice (F : Sets) :
  imply
    (Pred.term (Forall Sets Final (chMember F)))
    (Pred.term (Exist Sets Final (Forall Sets (Sets × Final) (chChoose F))))

#check @Subseteq
#check @SetEq
#check @pairing
#check @union_ax
#check @separation
#check @infBody
#check Inf
#check Inf_spec
#check @regularity
#check @replacement
#check @choice
