import set
import definite_description
import set_constructions
import set_equality
import classical_first_order_logic_new
import cartesian_combinators

-- The natural numbers, constructed inside ZF (von Neumann ω), in the new point-free HOL.
--
--   0 = ∅              (emptyset, from set_constructions)
--   succ n = n ∪ {n}   (nsucc,    from set_constructions)
--   ℕ = ω              the smallest inductive set
--
-- No axioms live in this file.  The Axiom of Infinity is postulated in set.cor as a named
-- witness `Inf` (inductive sets are not unique, so it cannot be described by `the`); ω is
-- carved out of `Inf` by Separation — which IS unique — exactly like `bigunion` in
-- set_constructions.cor: existence is `separation Inf omegaPred`, uniqueness is `uniqueOf`.

-- ===== ω's characterizing predicate:  omegaPred w  =  ∀J. (isInductive J → w∈J) =====
-- "w lies in every inductive set."  Built INLINE in one de-Bruijn tower (uniform-atom
-- discipline): the quantified inductive set J is the head, the tested element w the tail.
--
-- `isInductive J` is the RELATIONAL form, identical in shape to set.cor's `infBody`:
--   ∃e.(e∈J ∧ isEmpty e)  ∧  ∀x.(x∈J → ∃y.(y∈J ∧ isSucc x y)).
-- The functional form  emptyset∈J ∧ ∀x.(x∈J → nsucc x∈J)  is NOT expressible: the term-former
-- `nsucc` has a head parameter, so it cannot be applied to a bound x nor composed point-free.
-- Successor is therefore stated with the RELATION `isSucc` (set.cor); the pins tying isEmpty /
-- isSucc back to the terms emptyset / nsucc are discharged where omegaPred is consumed.

-- context (J, w) : Sets × Sets   [J = candidate inductive set, w = tested element]
noncomputable def wInJ : Pred (Sets × Sets) :=
  sub2 (Sets × Sets) Sets Sets Elem (snd Sets Sets) (fst Sets Sets)

-- J contains an empty set:  ∃e.(e∈J ∧ isEmpty e).   context (e,(J,w)) : Sets × (Sets × Sets)
noncomputable def emptyConj : Pred (Sets × (Sets × Sets)) :=
  Pred.and (Sets × (Sets × Sets))
    (sub2 (Sets × (Sets × Sets)) Sets Sets Elem (v0 Sets (Sets × Sets)) (v1 Sets Sets Sets))
    (isEmpty ∘ (v0 Sets (Sets × Sets)))
noncomputable def hasEmptyJ : Pred (Sets × Sets) :=
  Exist Sets (Sets × Sets) emptyConj

-- J is closed under successor:  ∀x.(x∈J → ∃y.(y∈J ∧ isSucc x y)).
-- context (x,(J,w)) : Sets × (Sets × Sets);  ∃y adds (y,(x,(J,w))) : Sets × (Sets × (Sets × Sets))
noncomputable def succConj : Pred (Sets × (Sets × (Sets × Sets))) :=
  Pred.and (Sets × (Sets × (Sets × Sets)))
    (sub2 (Sets × (Sets × (Sets × Sets))) Sets Sets Elem
      (v0 Sets (Sets × (Sets × Sets))) (v2 Sets Sets Sets Sets))
    (sub2 (Sets × (Sets × (Sets × Sets))) Sets Sets isSucc
      (v1 Sets Sets (Sets × Sets)) (v0 Sets (Sets × (Sets × Sets))))
noncomputable def closedJ : Pred (Sets × Sets) :=
  Forall Sets (Sets × Sets)
    (Pred.imply (Sets × (Sets × Sets))
      (sub2 (Sets × (Sets × Sets)) Sets Sets Elem (v0 Sets (Sets × Sets)) (v1 Sets Sets Sets))
      (Exist Sets (Sets × (Sets × Sets)) succConj))

-- J is inductive:  hasEmptyJ ∧ closedJ
noncomputable def isInductiveJ : Pred (Sets × Sets) :=
  Pred.and (Sets × Sets) hasEmptyJ closedJ

-- omegaPred w :  ∀J. (isInductive J → w∈J)
noncomputable def omegaPred : Pred Sets :=
  Forall Sets Sets (Pred.imply (Sets × Sets) isInductiveJ wInJ)

-- ===== ω = { w ∈ Inf : omegaPred w }  via Separation (existence) + uniqueOf (uniqueness) =====
-- omegaBody is EXACTLY the body of set.cor's separation axiom at A:=Inf, φ:=omegaPred, so
-- existence matches `separation Inf omegaPred` by defeq; uniqueness is the generic `uniqueOf`.
noncomputable def omegaBody : Pred (Sets × (Sets × Final)) :=
  Pred.and (Sets × (Sets × Final))
    (sub2 (Sets × (Sets × Final)) Sets Sets Elem (v0 Sets (Sets × Final))
      (Cart.weakening Sets (Sets × (Sets × Final)) Inf))
    (omegaPred ∘ (v0 Sets (Sets × Final)))

noncomputable def omegaExU : ExistUnique Sets Elem omegaBody :=
  and_intro (existsChar Sets Elem omegaBody) (Pred.term (Unique Sets Elem omegaBody))
    (separation Inf omegaPred) (uniqueOf Sets Elem omegaBody)

noncomputable def omega : Sets := the Sets Elem omegaBody omegaExU
noncomputable def omega_spec : hasChar Sets Elem omegaBody omega :=
  the_spec Sets Elem omegaBody omegaExU

-- the natural numbers, with zero and successor.
noncomputable def N : Sets := omega
noncomputable def zero : Sets := emptyset

-- ===== reading ω-membership:  t∈Inf ∧ omegaPred t ⊢ t∈ω  (the `mpr` half of ω's spec) =====
-- Instantiate omega_spec at the point t (hasChar_at), then feed the two conjuncts back through the
-- point β-bridges: `atomBeta` reads the `t∈Inf` atom of the Separation body, and `sepPhiBeta` reads
-- the φ-slot as exactly `omegaPred t`.
noncomputable def omega_intro (t : Sets) (h : and (elem t Inf) (omegaPred t)) : elem t omega :=
  iff_mp _ _ (curry_uncurry Sets Sets elem t omega)
    (iff_mp _ _ (memBeta Sets Elem t omega)
      (iff_mpr _ _ (hasChar_at Sets Elem omegaBody omega omega_spec t)
        (iff_mpr _ _
          (term_and (Sets × (Sets × Final)) (smap Sets omega ∘ pointAt Sets t)
            (sub2 (Sets × (Sets × Final)) Sets Sets Elem
              (v0 Sets (Sets × Final)) (Cart.weakening Sets (Sets × (Sets × Final)) Inf))
            (omegaPred ∘ (v0 Sets (Sets × Final))))
          (and_intro _ _
            (iff_mpr _ _ (atomBeta Sets Elem omega Inf t)
              (iff_mpr _ _ (curry_uncurry Sets Sets elem t Inf) (and_elim_left _ _ h)))
            (iff_mpr _ _ (sepPhiBeta Sets omegaPred omega t) (and_elim_right _ _ h))))))

-- ===== reading emptiness at a point:  isEmpty s ⊢ ¬(n∈s) =====
-- Evaluate the context-quantifier `isEmpty s = Forall Sets Sets (¬Elem) s` at the point s
-- (Forall_pointEval), instantiate the inner ∀z at z:=n (Forall_elim — the atom `z∈s` is
-- memAt-clean because v0 ≡ fst), split ¬ with term_not, and cross memBeta/curry_uncurry.
noncomputable def empty_not_mem (s n : Sets) (h : isEmpty s) : not (elem n s) :=
  not_cong_mp
    (Pred.term ((memAt Sets Elem s) ∘ pointAt Sets n))
    (elem n s)
    (iff_trans _ _ _ (memBeta Sets Elem n s) (curry_uncurry Sets Sets elem n s))
    (iff_mp _ _
      (term_not (Sets × Final) (pointAt Sets n) (memAt Sets Elem s))
      (imply_elim _ _
        (Forall_elim Sets (Pred.not (Sets × Final) (memAt Sets Elem s)) n)
        (iff_mp _ _
          (Forall_pointEval Sets Sets (Pred.not (Sets × Sets) Elem) s)
          h)))

-- ===== 0 ≠ succ n =====
-- If ∅ = succ n then n ∈ ∅ (n ∈ succ n by nsucc_self, transported along the equality flipped by
-- SetEq_sym_fun), but ∅ is empty.  The refutation function is a ∘-chain of the composable transports.
noncomputable def zero_ne_succ (n : Sets) : not (curry Sets Sets PC SetEq zero (nsucc n)) :=
  not_intro (curry Sets Sets PC SetEq zero (nsucc n)) (elem n zero)
    (mem_subst_fun n (nsucc n) zero (nsucc_self n) ∘ SetEq_sym_fun zero (nsucc n))
    (PropComb.k_comb (not (elem n zero)) (curry Sets Sets PC SetEq zero (nsucc n))
      (empty_not_mem zero n emptyset_spec))

#check omegaPred
#check omega
#check omega_spec
#check N
#check zero
#check empty_not_mem
#check zero_ne_succ
