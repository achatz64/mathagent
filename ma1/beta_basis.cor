import classical_first_order_logic_new

-- The candidate finite β-BASIS (infra layer).
--
-- Every "bridge" axiom reads a stored combinator formula back to a cleaner form.
-- Previously each was postulated per context shape (memBeta, Forall_orAtomsClean, …
-- — core.md lesson 5).  This file states the basis they derive from instead: the
-- categorical β-equations (curry/uncurry, fst/snd ∘ pair, weakening ∘ s), which Core
-- cannot state at arbitrary Type (no equality there), OBSERVED through a PC-valued
-- predicate — either at a point (★) or under one object-∀ binder.  Observed forms are
-- legal (iff/Forall-closed iff live at PC) and each is a model validity.
--
-- Two families, mirroring the two observation contexts:
--   * point-level:  equation observed at PC after evaluation at ★.
--   * binder-level: equation observed under one ∀ over context I × Final; the SOURCE
--     context Z stays generic, so one schema covers every depth of the reindexed body.
-- Plus ∀-lifted congruence rules (family (C) fibre generators) to compose observations.

-- ===== the point substitution  w := t :  Final → X × Final,  (⋆) ↦ (t, ⋆) =====
-- (moved here from definite_description.cor: the point-level basis observes at it.)
noncomputable def pointAt (X : Type) (t : X) : Final -> X × Final :=
  pair Final X Final (Cart.weakening X Final t) (Cart.i_comb Final)

-- ===== point-level basis =====

-- curry/uncurry β observed at PC: a sub2-built atom evaluated at a point is the curried
-- relation applied to the Final.term readings of its two substituted argument maps.
-- MODEL: ((sub2 Z A B Q f g) ∘ s) ★ = Q (f (s★), g (s★)) and
--        curry Q (Final.term (f∘s)) (Final.term (g∘s)) = Q (f (s★), g (s★)).
-- NON-DERIVABLE: the pair/uncurry β lives at the arbitrary Type Z, where = is
-- unavailable; it is postulable only observed at PC.
axiom beta_sub2_point (Z A B : Type) (Q : Pred (A × B)) (f : Z → A) (g : Z → B)
    (s : Final → Z) :
  iff (Pred.term ((sub2 Z A B Q f g) ∘ s))
      (curry A B PC Q (Final.term A (f ∘ s)) (Final.term B (g ∘ s)))

-- v0∘pointAt β observed through the first argument of a PC-valued context.
-- MODEL: Final.term ((v0 A Final) ∘ pointAt A a) = fst (a, ★) = a; both sides F a b.
-- NON-DERIVABLE: fst ∘ pair β at arbitrary Type; observed at PC only.
axiom beta_v0_point_arg1 (A B : Type) (F : A → B → PC) (a : A) (b : B) :
  iff (F (Final.term A ((v0 A Final) ∘ pointAt A a)) b) (F a b)

-- same law, second argument slot.
-- MODEL: as beta_v0_point_arg1; both sides F a b.
axiom beta_v0_point_arg2 (A B : Type) (F : A → B → PC) (a : A) (b : B) :
  iff (F a (Final.term B ((v0 B Final) ∘ pointAt B b))) (F a b)

-- unary version of v0∘pointAt β, for schema predicate slots `phi ∘ v0`.
-- MODEL: Final.term ((v0 A Final) ∘ pointAt A a) = a; both sides P a.
axiom beta_v0_point_unary (A : Type) (P : Pred A) (a : A) :
  iff (Pred.term (P ∘ ((v0 A Final) ∘ pointAt A a))) (P a)

-- fst∘pair β observed at a point through the first slot of a binary PC-valued context.
-- MODEL: fst(pair(f,g)(★)) = f(★); both sides F (f★) c.
-- NON-DERIVABLE: fst∘pair β lives at arbitrary Type; observed at PC only.
axiom beta_fst_pair_point_arg1 (Z A B C : Type) (F : A → C → PC)
    (f : Z → A) (g : Z → B) (s : Final → Z) (c : C) :
  iff (F (Final.term A ((fst A B) ∘ ((pair Z A B f g) ∘ s))) c)
      (F (Final.term A (f ∘ s)) c)

-- unary version of the same point observation, for `phi ∘ fst`.
-- MODEL: at ★ both sides are P(f(★)).
axiom beta_fst_pair_point_unary (Z A B : Type) (P : Pred A)
    (f : Z → A) (g : Z → B) (s : Final → Z) :
  iff (Pred.term ((P ∘ (fst A B)) ∘ ((pair Z A B f g) ∘ s)))
      (Pred.term (P ∘ (f ∘ s)))

-- weakening∘s β (a constant map composed with anything is the constant), observed
-- through the first argument of a PC-valued context.
-- MODEL: Final.term ((Cart.weakening A Z a) ∘ s) = a; both sides F a b.
-- NON-DERIVABLE: the const β lives at arbitrary Type Z; observed at PC only.
axiom beta_weakening_arg1 (A B Z : Type) (F : A → B → PC) (a : A) (b : B)
    (s : Final → Z) :
  iff (F (Final.term A ((Cart.weakening A Z a) ∘ s)) b) (F a b)

-- same law, second argument slot.
-- MODEL: as beta_weakening_arg1; both sides F a b.
axiom beta_weakening_arg2 (A B Z : Type) (F : A → B → PC) (a : A) (b : B)
    (s : Final → Z) :
  iff (F a (Final.term B ((Cart.weakening B Z b) ∘ s))) (F a b)

-- ===== binder-level basis: connective reindexing homomorphisms =====

-- connectives are pointwise in the model, so reindexing distributes over them:
-- (P ∨ Q) ∘ s = (P∘s) ∨ (Q∘s) pointwise — the ∀-closure of a fibre tautology.
-- MODEL: at (x,★) both sides are P(s(x,★)) ∨ Q(s(x,★)).
-- NON-DERIVABLE: Pred.or is opaque; the pointwise law lives at Pred Y where = is
-- unavailable — postulable only as a Forall-closed iff at PC.
axiom Forall_or_reindex_beta (X Y : Type) (s : X × Final → Y) (P Q : Pred Y) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((Pred.or Y P Q) ∘ s)
    (Pred.or (X × Final) (P ∘ s) (Q ∘ s))))

-- ∧-version of Forall_or_reindex_beta.
-- MODEL: at (x,★) both sides are P(s(x,★)) ∧ Q(s(x,★)).
axiom Forall_and_reindex_beta (I Y : Type) (s : I × Final → Y) (P Q : Pred Y) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    ((Pred.and Y P Q) ∘ s)
    (Pred.and (I × Final) (P ∘ s) (Q ∘ s))))

-- implication-version of Forall_or_reindex_beta.
-- MODEL: at (x,★) both sides are P(s(x,★)) → Q(s(x,★)).
axiom Forall_imp_reindex_beta (I Y : Type) (s : I × Final → Y) (P Q : Pred Y) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    ((Pred.imply Y P Q) ∘ s)
    (Pred.imply (I × Final) (P ∘ s) (Q ∘ s))))

-- iff-version of Forall_or_reindex_beta.
-- MODEL: at (x,★) both sides are P(s(x,★)) ↔ Q(s(x,★)).
axiom Forall_iff_reindex_beta (I Y : Type) (s : I × Final → Y) (P Q : Pred Y) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    ((Pred.iff Y P Q) ∘ s)
    (Pred.iff (I × Final) (P ∘ s) (Q ∘ s))))

-- negation-version of Forall_or_reindex_beta.
-- MODEL: at (x,★) both sides are ¬P(s(x,★)).
axiom Forall_not_reindex_beta (I Y : Type) (s : I × Final → Y) (P : Pred Y) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    ((Pred.not Y P) ∘ s)
    (Pred.not (I × Final) (P ∘ s))))

-- unary predicate-slot reindexing: substituting into `P ∘ u` composes the map into
-- the argument slot.  This is the general φ-slot counterpart of sub2 reindexing.
-- MODEL: at (i,★), ((P ∘ u) ∘ s)(i,★) = P(u(s(i,★))) = (P ∘ (u∘s))(i,★).
-- NON-DERIVABLE: composition associativity lives at arbitrary Type; observed under ∀.
axiom Forall_unary_reindex_beta (I Z A : Type) (P : Pred A)
    (u : Z → A) (s : I × Final → Z) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    ((P ∘ u) ∘ s)
    (P ∘ (u ∘ s))))

-- ===== binder-level basis: ∀-lifted connective congruences (family (C)) =====

-- ∨ respects ↔ under the binder: from ∀(A↔A') and ∀(B↔B') conclude ∀(A∨B ↔ A'∨B').
-- MODEL: fibre validity — (A↔A') → (B↔B') → (A∨B ↔ A'∨B') is a propositional
-- tautology, closed under ∀.  Stated directly (like the other family-(C) generators)
-- pending a generic fibre-tautology generator.
axiom Forall_orCong (X : Type) (A A' B B' : Pred (X × Final)) :
  imply (Pred.term (Forall X Final (Pred.iff (X × Final) A A')))
    (imply (Pred.term (Forall X Final (Pred.iff (X × Final) B B')))
      (Pred.term (Forall X Final (Pred.iff (X × Final)
        (Pred.or (X × Final) A B)
        (Pred.or (X × Final) A' B')))))

-- ∧-version of Forall_orCong.
-- MODEL: (A↔A') → (B↔B') → (A∧B ↔ A'∧B') is a propositional tautology, closed under ∀.
axiom Forall_andCong (I : Type) (A A' B B' : Pred (I × Final)) :
  imply (Pred.term (Forall I Final (Pred.iff (I × Final) A A')))
    (imply (Pred.term (Forall I Final (Pred.iff (I × Final) B B')))
      (Pred.term (Forall I Final (Pred.iff (I × Final)
        (Pred.and (I × Final) A B)
        (Pred.and (I × Final) A' B')))))

-- implication-version of Forall_andCong.
-- MODEL: (A↔A') → (B↔B') → ((A→B) ↔ (A'→B')) is a propositional tautology, closed under ∀.
axiom Forall_impCong (I : Type) (A A' B B' : Pred (I × Final)) :
  imply (Pred.term (Forall I Final (Pred.iff (I × Final) A A')))
    (imply (Pred.term (Forall I Final (Pred.iff (I × Final) B B')))
      (Pred.term (Forall I Final (Pred.iff (I × Final)
        (Pred.imply (I × Final) A B)
        (Pred.imply (I × Final) A' B')))))

-- iff-version of Forall_andCong.
-- MODEL: (A↔A') → (B↔B') → ((A↔B) ↔ (A'↔B')) is a propositional tautology, closed under ∀.
axiom Forall_iffCong (I : Type) (A A' B B' : Pred (I × Final)) :
  imply (Pred.term (Forall I Final (Pred.iff (I × Final) A A')))
    (imply (Pred.term (Forall I Final (Pred.iff (I × Final) B B')))
      (Pred.term (Forall I Final (Pred.iff (I × Final)
        (Pred.iff (I × Final) A B)
        (Pred.iff (I × Final) A' B')))))

-- negation-version of the congruence generators.
-- MODEL: (A↔A') → (¬A ↔ ¬A') is a propositional tautology, closed under ∀.
axiom Forall_notCong (I : Type) (A A' : Pred (I × Final)) :
  imply (Pred.term (Forall I Final (Pred.iff (I × Final) A A')))
    (Pred.term (Forall I Final (Pred.iff (I × Final)
      (Pred.not (I × Final) A)
      (Pred.not (I × Final) A'))))

-- ===== binder-level basis: quantifier congruence and Beck-Chevalley =====

-- ∀ respects ↔ under an outer context: from ∀i∀x(P↔Q), conclude ∀i((∀xP)↔(∀xQ)).
-- MODEL: fibre validity — pointwise logical equivalence preserves universal quantification.
-- This is the generic-depth congruence needed by the substitution lemma's `all` case.
axiom Forall_ForallCong (X I : Type) (P Q : Pred (X × (I × Final))) :
  imply (Pred.term (Forall I Final (Forall X (I × Final)
    (Pred.iff (X × (I × Final)) P Q))))
    (Pred.term (Forall I Final (Pred.iff (I × Final)
      (Forall X (I × Final) P)
      (Forall X (I × Final) Q))))

-- ∃ respects ↔ under an outer context: from ∀i∀x(P↔Q), conclude ∀i((∃xP)↔(∃xQ)).
-- MODEL: fibre validity — pointwise logical equivalence preserves existential quantification.
-- This is the generic-depth congruence needed by the substitution lemma's `ex` case.
axiom Forall_ExistCong (X I : Type) (P Q : Pred (X × (I × Final))) :
  imply (Pred.term (Forall I Final (Forall X (I × Final)
    (Pred.iff (X × (I × Final)) P Q))))
    (Pred.term (Forall I Final (Pred.iff (I × Final)
      (Exist X (I × Final) P)
      (Exist X (I × Final) Q))))

-- ∃-SUBSTITUTION (Beck-Chevalley), the existential sibling of `Forall_reindex`.
-- FOL:  (∃x. R x y)[y := f z]  ↔  ∃x. R x (f z).
-- MODEL: at every (z,★) both sides compute to ∃x. R(x, f z).
axiom Exist_reindex (X Y0 Y : Type) (R : Pred (X × Y0)) (f : Y → Y0) :
  Pred.term (Forall Y Final (Pred.iff (Y × Final)
    ((Exist X Y0 R) ∘ (f ∘ fst Y Final))
    (Exist X (Y × Final)
      (R ∘ pair (X × (Y × Final)) X Y0
        (fst X (Y × Final))
        (f ∘ (fst Y Final ∘ snd X (Y × Final)))))))

-- ===== binder-level basis: product/terminal β observed under one ∀ =====

-- atom reindexing: substituting into a sub2 atom composes into its argument maps.
-- MODEL: at (i,★), ((sub2 Q f g) ∘ s)(i,★) = Q(f(s(i,★)), g(s(i,★))) = (sub2 Q (f∘s) (g∘s))(i,★).
-- NON-DERIVABLE: uncurry/pair β at the arbitrary source Type Z; observed at PC under ∀.
axiom Forall_sub2_reindex_beta (I Z A B : Type) (Q : Pred (A × B))
    (f : Z → A) (g : Z → B) (s : I × Final → Z) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    ((sub2 Z A B Q f g) ∘ s)
    (sub2 (I × Final) A B Q (f ∘ s) (g ∘ s))))

-- fst ∘ pair β, observed through the LEFT slot of a binary atom.
-- MODEL: (fst ∘ pair f g)(i,★) = f(i,★); both sides Q(f(i,★), h(i,★)).
-- NON-DERIVABLE: fst∘pair β at arbitrary Type; observed at PC under ∀.
axiom Forall_fst_pair_beta_left (I A B C : Type) (Q : Pred (A × C))
    (f : I × Final → A) (g : I × Final → B) (h : I × Final → C) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) A C Q ((fst A B) ∘ (pair (I × Final) A B f g)) h)
    (sub2 (I × Final) A C Q f h)))

-- same fst∘pair β, observed through the RIGHT slot of a binary atom.
axiom Forall_fst_pair_beta_right (I A B C : Type) (Q : Pred (C × A))
    (h : I × Final → C) (f : I × Final → A) (g : I × Final → B) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) C A Q h ((fst A B) ∘ (pair (I × Final) A B f g)))
    (sub2 (I × Final) C A Q h f)))

-- fst∘pair β with an explicit precomposition, observed through the LEFT slot.
-- MODEL: fst(pair(f,g)(s(i,★))) = f(s(i,★)); both sides Q(f(s(i,★)), h(i,★)).
axiom Forall_fst_pair_comp_beta_left (I Z A B C : Type) (Q : Pred (A × C))
    (f : Z → A) (g : Z → B) (s : I × Final → Z) (h : I × Final → C) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) A C Q ((fst A B) ∘ ((pair Z A B f g) ∘ s)) h)
    (sub2 (I × Final) A C Q (f ∘ s) h)))

-- grouped version needed when a pair-built map is first reindexed by `s`, then by `r`.
-- MODEL: fst(pair(f,g)(s(r(i,★)))) = f(s(r(i,★))).
axiom Forall_fst_pair_comp2_beta_left (I W Z A B C : Type) (Q : Pred (A × C))
    (f : Z → A) (g : Z → B) (s : W → Z) (r : I × Final → W) (h : I × Final → C) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) A C Q ((fst A B) ∘ (((pair Z A B f g) ∘ s) ∘ r)) h)
    (sub2 (I × Final) A C Q (f ∘ (s ∘ r)) h)))

-- fst ∘ pair β, observed through a UNARY predicate.
-- MODEL: ((P ∘ fst) ∘ pair f g)(i,★) = P(f(i,★)); both sides P(f(i,★)).
axiom Forall_fst_pair_unary_beta (I A B : Type) (P : Pred A)
    (f : I × Final → A) (g : I × Final → B) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    ((P ∘ (fst A B)) ∘ (pair (I × Final) A B f g))
    (P ∘ f)))

-- (k ∘ snd) ∘ pair β, observed through the RIGHT slot of a binary atom.
-- MODEL: ((k ∘ snd) ∘ pair f g)(i,★) = k(g(i,★)); both sides Q(h(i,★), k(g(i,★))).
axiom Forall_snd_pair_then_beta_right (I A B C D : Type) (Q : Pred (C × D))
    (h : I × Final → C) (k : B → D) (f : I × Final → A) (g : I × Final → B) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) C D Q h ((k ∘ (snd A B)) ∘ (pair (I × Final) A B f g)))
    (sub2 (I × Final) C D Q h (k ∘ g))))

-- same (k∘snd)∘pair β, observed through the LEFT slot of a binary atom.
axiom Forall_snd_pair_then_beta_left (I A B C D : Type) (Q : Pred (D × C))
    (k : B → D) (h : I × Final → C) (f : I × Final → A) (g : I × Final → B) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) D C Q ((k ∘ (snd A B)) ∘ (pair (I × Final) A B f g)) h)
    (sub2 (I × Final) D C Q (k ∘ g) h)))

-- fst ∘ pointAt β, observed through the left slot of a binary atom.
-- MODEL: (fst ∘ (pointAt c ∘ s))(i,★) = c.
axiom Forall_pointAt_fst_beta_left (I X C : Type) (Q : Pred (X × C))
    (c : X) (h : I × Final → C) (s : I × Final → Final) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) X C Q ((fst X Final) ∘ ((pointAt X c) ∘ s)) h)
    (sub2 (I × Final) X C Q ((Cart.weakening X Final c) ∘ s) h)))

-- fst ∘ pointAt β: pointAt c puts c in the first component, so reading fst back out
-- is the constant c — observed through the right slot of a binary atom.
-- MODEL: (fst ∘ (pointAt c ∘ s))(i,★) = fst (c, ★) = c = (weakening c ∘ s)(i,★).
axiom Forall_pointAt_fst_beta_right (I X C : Type) (Q : Pred (C × X))
    (h : I × Final → C) (c : X) (s : I × Final → Final) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) C X Q h ((fst X Final) ∘ ((pointAt X c) ∘ s)))
    (sub2 (I × Final) C X Q h ((Cart.weakening X Final c) ∘ s))))

-- weakening ∘ s β (const composed with anything is the const), observed through the
-- right slot of a binary atom under ∀.
-- MODEL: ((weakening b) ∘ s)(i,★) = b; both sides Q(f(i,★), b).
axiom Forall_const_comp_beta_right (I A B Z : Type) (Q : Pred (A × B))
    (f : I × Final → A) (b : B) (s : I × Final → Z) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) A B Q f ((Cart.weakening B Z b) ∘ s))
    (sub2 (I × Final) A B Q f (Cart.weakening B (I × Final) b))))

-- weakening ∘ s β, observed through the left slot of a binary atom under ∀.
-- MODEL: ((weakening a) ∘ s)(i,★) = a; both sides Q(a, h(i,★)).
axiom Forall_const_comp_beta_left (I A B Z : Type) (Q : Pred (A × B))
    (a : A) (h : I × Final → B) (s : I × Final → Z) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) A B Q ((Cart.weakening A Z a) ∘ s) h)
    (sub2 (I × Final) A B Q (Cart.weakening A (I × Final) a) h)))

-- ===== derived glue: chain two Forall-closed iffs (uses only Forall_mono / Forall_iffTrans) =====
noncomputable def Forall_iffSym_apply (X : Type) (A B : Pred (X × Final))
    (h : Pred.term (Forall X Final (Pred.iff (X × Final) A B))) :
    Pred.term (Forall X Final (Pred.iff (X × Final) B A)) :=
  imply_elim _ _
    (imply_elim _ _
      (Forall_mono X
        (Pred.iff (X × Final) A B)
        (Pred.iff (X × Final) B A))
      (Forall_iffSym X A B))
    h

noncomputable def Forall_iffTrans_apply (X : Type) (A B C : Pred (X × Final))
    (h1 : Pred.term (Forall X Final (Pred.iff (X × Final) A B)))
    (h2 : Pred.term (Forall X Final (Pred.iff (X × Final) B C))) :
    Pred.term (Forall X Final (Pred.iff (X × Final) A C)) :=
  imply_elim _ _
    (imply_elim _ _
      (Forall_mono X
        (Pred.iff (X × Final) B C)
        (Pred.iff (X × Final) A C))
      (imply_elim _ _
        (imply_elim _ _
          (Forall_mono X
            (Pred.iff (X × Final) A B)
            (Pred.imply (X × Final)
              (Pred.iff (X × Final) B C)
              (Pred.iff (X × Final) A C)))
          (Forall_iffTrans X A B C))
        h1))
    h2

-- Derived grouped unary fst∘pair cleaner.  The primitive unary observation uses
-- `((P∘fst)∘pair)`; the general unary reindex axiom bridges that to
-- `P∘(fst∘pair)`, which is the shape emitted by the papp substitution case.
noncomputable def Forall_fst_pair_unary_beta_grouped (I A B : Type) (P : Pred A)
    (f : I × Final → A) (g : I × Final → B) :
    Pred.term (Forall I Final (Pred.iff (I × Final)
      (P ∘ ((fst A B) ∘ (pair (I × Final) A B f g)))
      (P ∘ f))) :=
  Forall_iffTrans_apply I
    (P ∘ ((fst A B) ∘ (pair (I × Final) A B f g)))
    ((P ∘ (fst A B)) ∘ (pair (I × Final) A B f g))
    (P ∘ f)
    (Forall_iffSym_apply I
      ((P ∘ (fst A B)) ∘ (pair (I × Final) A B f g))
      (P ∘ ((fst A B) ∘ (pair (I × Final) A B f g)))
      (Forall_unary_reindex_beta I (A × B) A P
        (fst A B)
        (pair (I × Final) A B f g)))
    (Forall_fst_pair_unary_beta I A B P f g)

#check @beta_sub2_point
#check @Forall_sub2_reindex_beta
#check @Forall_unary_reindex_beta
#check @Forall_ForallCong
#check @Forall_ExistCong
#check @Exist_reindex
#check @Forall_iffTrans_apply
#check @Forall_fst_pair_unary_beta_grouped
