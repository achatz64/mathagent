import definite_description

-- Experiment: a smaller Core-level beta basis for point readers.
--
-- This file is intentionally separate from the live infra files.  The question is
-- whether point-shape axioms such as memBeta / memBetaRev / constAtomBeta can be
-- derived from more primitive, still-Core declarations.

-- Generic point evaluation of a binary predicate applied by sub2.  This packages
-- the pair/curry beta at PC, but leaves the two arguments as Final.term readings of
-- the substituted maps.
axiom beta_sub2_point (Z A B : Type) (Q : Pred (A × B)) (f : Z → A) (g : Z → B)
    (s : Final → Z) :
  iff (Pred.term ((sub2 Z A B Q f g) ∘ s))
      (curry A B PC Q (Final.term A (f ∘ s)) (Final.term B (g ∘ s)))

-- Observed terminal/product beta for the two argument positions of a binary PC-valued
-- context.  These are still Core axioms: no Eq, no lambda, no Lean rewriting.
axiom beta_v0_point_arg1 (A B : Type) (F : A → B → PC) (a : A) (b : B) :
  iff (F (Final.term A ((v0 A Final) ∘ pointAt A a)) b) (F a b)

axiom beta_v0_point_arg2 (A B : Type) (F : A → B → PC) (a : A) (b : B) :
  iff (F a (Final.term B ((v0 B Final) ∘ pointAt B b))) (F a b)

axiom beta_weakening_arg1 (A B Z : Type) (F : A → B → PC) (a : A) (b : B)
    (s : Final → Z) :
  iff (F (Final.term A ((Cart.weakening A Z a) ∘ s)) b) (F a b)

axiom beta_weakening_arg2 (A B Z : Type) (F : A → B → PC) (a : A) (b : B)
    (s : Final → Z) :
  iff (F a (Final.term B ((Cart.weakening B Z b) ∘ s))) (F a b)

-- Existing point reader, now derived from the smaller basis.
noncomputable def memBeta_from_basis (X : Type) (elt : Pred (X × X)) (t s : X) :
  iff (Pred.term ((memAt X elt s) ∘ pointAt X t)) (curry X X PC elt t s) :=
  iff_trans _ _ _
    (beta_sub2_point (X × Final) X X elt
      (v0 X Final)
      (Cart.weakening X (X × Final) s)
      (pointAt X t))
    (iff_trans _ _ _
      (beta_v0_point_arg1 X X (curry X X PC elt) t
        (Final.term X ((Cart.weakening X (X × Final) s) ∘ pointAt X t)))
      (beta_weakening_arg2 X X (X × Final) (curry X X PC elt) t s (pointAt X t)))

-- Existing reversed-slot point reader, also derived.
noncomputable def memBetaRev_from_basis (X : Type) (elt : Pred (X × X)) (z t : X) :
  iff (Pred.term
        ((sub2 (X × Final) X X elt (Cart.weakening X (X × Final) z) (v0 X Final))
          ∘ pointAt X t))
      (curry X X PC elt z t) :=
  iff_trans _ _ _
    (beta_sub2_point (X × Final) X X elt
      (Cart.weakening X (X × Final) z)
      (v0 X Final)
      (pointAt X t))
    (iff_trans _ _ _
      (beta_weakening_arg1 X X (X × Final) (curry X X PC elt) z
        (Final.term X ((v0 X Final) ∘ pointAt X t))
        (pointAt X t))
      (beta_v0_point_arg2 X X (curry X X PC elt) z t))

-- Existing both-constant point reader, also derived.
noncomputable def constAtomBeta_from_basis (X : Type) (elt : Pred (X × X)) (c d t : X) :
  iff (Pred.term
        ((sub2 (X × Final) X X elt
            (Cart.weakening X (X × Final) c)
            (Cart.weakening X (X × Final) d))
          ∘ pointAt X t))
      (curry X X PC elt c d) :=
  iff_trans _ _ _
    (beta_sub2_point (X × Final) X X elt
      (Cart.weakening X (X × Final) c)
      (Cart.weakening X (X × Final) d)
      (pointAt X t))
    (iff_trans _ _ _
      (beta_weakening_arg1 X X (X × Final) (curry X X PC elt) c
        (Final.term X ((Cart.weakening X (X × Final) d) ∘ pointAt X t))
        (pointAt X t))
      (beta_weakening_arg2 X X (X × Final) (curry X X PC elt) c d (pointAt X t)))

#check @memBeta_from_basis
#check @memBetaRev_from_basis
#check @constAtomBeta_from_basis

-- Binder-level connective reindexing and propositional congruence.  These are the
-- Forall-closed counterparts of term_or and ordinary PC or-congruence.
axiom Forall_or_reindex_beta (X Y : Type) (s : X × Final → Y) (P Q : Pred Y) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((Pred.or Y P Q) ∘ s)
    (Pred.or (X × Final) (P ∘ s) (Q ∘ s))))

axiom Forall_orCong (X : Type) (A A' B B' : Pred (X × Final)) :
  imply (Pred.term (Forall X Final (Pred.iff (X × Final) A A')))
    (imply (Pred.term (Forall X Final (Pred.iff (X × Final) B B')))
      (Pred.term (Forall X Final (Pred.iff (X × Final)
        (Pred.or (X × Final) A B)
        (Pred.or (X × Final) A' B')))))

-- Single-atom binder cleaner.  The existing Forall_orAtomsClean bundles two copies
-- of this with or-reindexing and or-congruence.
axiom Forall_atomSmapClean (X : Type) (R : Pred (X × X)) (a s : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((sub2 (X × (X × Final)) X X R
        (v0 X (X × Final))
        (Cart.weakening X (X × (X × Final)) a))
      ∘ smap X s)
    (sub2 (X × Final) X X R
      (v0 X Final)
      (Cart.weakening X (X × Final) a))))

-- Apply the already-present Forall_iffTrans generator to two closed Forall-iff facts.
noncomputable def Forall_iffTrans_apply (X : Type) (A B C : Pred (X × Final))
    (h1 : Pred.term (Forall X Final (Pred.iff (X × Final) A B)))
    (h2 : Pred.term (Forall X Final (Pred.iff (X × Final) B C))) :
    Pred.term (Forall X Final (Pred.iff (X × Final) A C)) :=
  imply_elim _ _
    (imply_elim _ _
      (Forall_mono X
        (Pred.iff (X × Final) B C)
        (Pred.iff (X × Final) A C))
      (imply_elim _ _
        (imply_elim _ _
          (Forall_mono X
            (Pred.iff (X × Final) A B)
            (Pred.imply (X × Final)
              (Pred.iff (X × Final) B C)
              (Pred.iff (X × Final) A C)))
          (Forall_iffTrans X A B C))
        h1))
    h2

-- Existing bundled or-atoms cleaner, now derived from smaller binder-level pieces.
noncomputable def Forall_orAtomsClean_from_basis (X : Type) (R : Pred (X × X))
    (a b s : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((Pred.or (X × (X × Final))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) a))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) b)))
     ∘ smap X s)
    (Pred.or (X × Final)
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) a))
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) b))))) :=
  Forall_iffTrans_apply X
    ((Pred.or (X × (X × Final))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) a))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) b)))
     ∘ smap X s)
    (Pred.or (X × Final)
      ((sub2 (X × (X × Final)) X X R
          (v0 X (X × Final))
          (Cart.weakening X (X × (X × Final)) a))
        ∘ smap X s)
      ((sub2 (X × (X × Final)) X X R
          (v0 X (X × Final))
          (Cart.weakening X (X × (X × Final)) b))
        ∘ smap X s))
    (Pred.or (X × Final)
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) a))
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) b)))
    (Forall_or_reindex_beta X (X × (X × Final)) (smap X s)
      (sub2 (X × (X × Final)) X X R
        (v0 X (X × Final))
        (Cart.weakening X (X × (X × Final)) a))
      (sub2 (X × (X × Final)) X X R
        (v0 X (X × Final))
        (Cart.weakening X (X × (X × Final)) b)))
    (imply_elim _ _
      (imply_elim _ _
        (Forall_orCong X
          ((sub2 (X × (X × Final)) X X R
              (v0 X (X × Final))
              (Cart.weakening X (X × (X × Final)) a))
            ∘ smap X s)
          (sub2 (X × Final) X X R
            (v0 X Final)
            (Cart.weakening X (X × Final) a))
          ((sub2 (X × (X × Final)) X X R
              (v0 X (X × Final))
              (Cart.weakening X (X × (X × Final)) b))
            ∘ smap X s)
          (sub2 (X × Final) X X R
            (v0 X Final)
            (Cart.weakening X (X × Final) b)))
        (Forall_atomSmapClean X R a s))
      (Forall_atomSmapClean X R b s))

#check @Forall_orAtomsClean_from_basis

-- A more principled binder-level product basis.  These state the β-laws of
-- reindexing, fst(pair ...), and constants only after observing them through a
-- PC-valued binary predicate under Forall.

axiom Forall_sub2_reindex_beta (I Z A B : Type) (Q : Pred (A × B))
    (f : Z → A) (g : Z → B) (s : I × Final → Z) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    ((sub2 Z A B Q f g) ∘ s)
    (sub2 (I × Final) A B Q (f ∘ s) (g ∘ s))))

axiom Forall_fst_pair_beta_left (I A B C : Type) (Q : Pred (A × C))
    (f : I × Final → A) (g : I × Final → B) (h : I × Final → C) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) A C Q ((fst A B) ∘ (pair (I × Final) A B f g)) h)
    (sub2 (I × Final) A C Q f h)))

axiom Forall_const_comp_beta_right (I A B Z : Type) (Q : Pred (A × B))
    (f : I × Final → A) (b : B) (s : I × Final → Z) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) A B Q f ((Cart.weakening B Z b) ∘ s))
    (sub2 (I × Final) A B Q f (Cart.weakening B (I × Final) b))))

-- The formerly shape-specific single-atom cleaner, now derived from the
-- product/terminal observation laws above.
noncomputable def Forall_atomSmapClean_from_product_basis (X : Type)
    (R : Pred (X × X)) (a s : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((sub2 (X × (X × Final)) X X R
        (v0 X (X × Final))
        (Cart.weakening X (X × (X × Final)) a))
      ∘ smap X s)
    (sub2 (X × Final) X X R
      (v0 X Final)
      (Cart.weakening X (X × Final) a)))) :=
  Forall_iffTrans_apply X
    ((sub2 (X × (X × Final)) X X R
        (v0 X (X × Final))
        (Cart.weakening X (X × (X × Final)) a))
      ∘ smap X s)
    (sub2 (X × Final) X X R
      ((v0 X (X × Final)) ∘ smap X s)
      ((Cart.weakening X (X × (X × Final)) a) ∘ smap X s))
    (sub2 (X × Final) X X R
      (v0 X Final)
      (Cart.weakening X (X × Final) a))
    (Forall_sub2_reindex_beta X (X × (X × Final)) X X R
      (v0 X (X × Final))
      (Cart.weakening X (X × (X × Final)) a)
      (smap X s))
    (Forall_iffTrans_apply X
      (sub2 (X × Final) X X R
        ((v0 X (X × Final)) ∘ smap X s)
        ((Cart.weakening X (X × (X × Final)) a) ∘ smap X s))
      (sub2 (X × Final) X X R
        (v0 X Final)
        ((Cart.weakening X (X × (X × Final)) a) ∘ smap X s))
      (sub2 (X × Final) X X R
        (v0 X Final)
        (Cart.weakening X (X × Final) a))
      (Forall_fst_pair_beta_left X X (X × Final) X R
        (v0 X Final)
        (pair (X × Final) X Final
          (Cart.weakening X (X × Final) s)
          (snd X Final))
        ((Cart.weakening X (X × (X × Final)) a) ∘ smap X s))
      (Forall_const_comp_beta_right X X X (X × (X × Final)) R
        (v0 X Final)
        a
        (smap X s)))

-- Same bundled cleaner as before, now with the single-atom piece derived from
-- product/terminal observations rather than postulated.
noncomputable def Forall_orAtomsClean_from_product_basis (X : Type) (R : Pred (X × X))
    (a b s : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((Pred.or (X × (X × Final))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) a))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) b)))
     ∘ smap X s)
    (Pred.or (X × Final)
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) a))
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) b))))) :=
  Forall_iffTrans_apply X
    ((Pred.or (X × (X × Final))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) a))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) b)))
     ∘ smap X s)
    (Pred.or (X × Final)
      ((sub2 (X × (X × Final)) X X R
          (v0 X (X × Final))
          (Cart.weakening X (X × (X × Final)) a))
        ∘ smap X s)
      ((sub2 (X × (X × Final)) X X R
          (v0 X (X × Final))
          (Cart.weakening X (X × (X × Final)) b))
        ∘ smap X s))
    (Pred.or (X × Final)
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) a))
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) b)))
    (Forall_or_reindex_beta X (X × (X × Final)) (smap X s)
      (sub2 (X × (X × Final)) X X R
        (v0 X (X × Final))
        (Cart.weakening X (X × (X × Final)) a))
      (sub2 (X × (X × Final)) X X R
        (v0 X (X × Final))
        (Cart.weakening X (X × (X × Final)) b)))
    (imply_elim _ _
      (imply_elim _ _
        (Forall_orCong X
          ((sub2 (X × (X × Final)) X X R
              (v0 X (X × Final))
              (Cart.weakening X (X × (X × Final)) a))
            ∘ smap X s)
          (sub2 (X × Final) X X R
            (v0 X Final)
            (Cart.weakening X (X × Final) a))
          ((sub2 (X × (X × Final)) X X R
              (v0 X (X × Final))
              (Cart.weakening X (X × (X × Final)) b))
            ∘ smap X s)
          (sub2 (X × Final) X X R
            (v0 X Final)
            (Cart.weakening X (X × Final) b)))
        (Forall_atomSmapClean_from_product_basis X R a s))
      (Forall_atomSmapClean_from_product_basis X R b s))

#check @Forall_atomSmapClean_from_product_basis
#check @Forall_orAtomsClean_from_product_basis

-- A harder test: derive the existing Forall_exMemPhiClean shape from
-- connective reindexing plus product/terminal observations.

axiom Forall_and_reindex_beta (I Y : Type) (s : I × Final → Y) (P Q : Pred Y) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    ((Pred.and Y P Q) ∘ s)
    (Pred.and (I × Final) (P ∘ s) (Q ∘ s))))

axiom Forall_andCong (I : Type) (A A' B B' : Pred (I × Final)) :
  imply (Pred.term (Forall I Final (Pred.iff (I × Final) A A')))
    (imply (Pred.term (Forall I Final (Pred.iff (I × Final) B B')))
      (Pred.term (Forall I Final (Pred.iff (I × Final)
        (Pred.and (I × Final) A B)
        (Pred.and (I × Final) A' B')))))

axiom Forall_fst_pair_unary_beta (I A B : Type) (P : Pred A)
    (f : I × Final → A) (g : I × Final → B) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    ((P ∘ (fst A B)) ∘ (pair (I × Final) A B f g))
    (P ∘ f)))

axiom Forall_snd_pair_then_beta_right (I A B C D : Type) (Q : Pred (C × D))
    (h : I × Final → C) (k : B → D) (f : I × Final → A) (g : I × Final → B) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) C D Q h ((k ∘ (snd A B)) ∘ (pair (I × Final) A B f g)))
    (sub2 (I × Final) C D Q h (k ∘ g))))

axiom Forall_fst_pair_reindex_beta_right (I Z A B C : Type) (Q : Pred (C × A))
    (h : I × Final → C) (f : Z → A) (g : Z → B) (s : I × Final → Z) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) C A Q h (((fst A B) ∘ (pair Z A B f g)) ∘ s))
    (sub2 (I × Final) C A Q h (f ∘ s))))

axiom Forall_pointAt_fst_beta_right (I X C : Type) (Q : Pred (C × X))
    (h : I × Final → C) (c : X) (s : I × Final → Final) :
  Pred.term (Forall I Final (Pred.iff (I × Final)
    (sub2 (I × Final) C X Q h ((fst X Final) ∘ ((pointAt X c) ∘ s)))
    (sub2 (I × Final) C X Q h ((Cart.weakening X Final c) ∘ s))))

noncomputable def Forall_exMemPhi_atomClean_from_product_basis (X : Type)
    (R : Pred (X × X)) (c : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
      ∘ (pair (X × Final) X (X × Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final)))
    (memAt X R c))) :=
  Forall_iffTrans_apply X
    ((sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
      ∘ (pair (X × Final) X (X × Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final)))
    (sub2 (X × Final) X X R
      ((v0 X (X × Final)) ∘ (pair (X × Final) X (X × Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final)))
      ((v1 X X Final) ∘ (pair (X × Final) X (X × Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final))))
    (memAt X R c)
    (Forall_sub2_reindex_beta X (X × (X × Final)) X X R
      (v0 X (X × Final))
      (v1 X X Final)
      (pair (X × Final) X (X × Final)
        (fst X Final)
        ((pointAt X c) ∘ snd X Final)))
    (Forall_iffTrans_apply X
      (sub2 (X × Final) X X R
        ((v0 X (X × Final)) ∘ (pair (X × Final) X (X × Final)
            (fst X Final)
            ((pointAt X c) ∘ snd X Final)))
        ((v1 X X Final) ∘ (pair (X × Final) X (X × Final)
            (fst X Final)
            ((pointAt X c) ∘ snd X Final))))
      (sub2 (X × Final) X X R
        (v0 X Final)
        ((v1 X X Final) ∘ (pair (X × Final) X (X × Final)
            (fst X Final)
            ((pointAt X c) ∘ snd X Final))))
      (memAt X R c)
      (Forall_fst_pair_beta_left X X (X × Final) X R
        (fst X Final)
        ((pointAt X c) ∘ snd X Final)
        ((v1 X X Final) ∘ (pair (X × Final) X (X × Final)
            (fst X Final)
            ((pointAt X c) ∘ snd X Final))))
      (Forall_iffTrans_apply X
        (sub2 (X × Final) X X R
          (v0 X Final)
          ((v1 X X Final) ∘ (pair (X × Final) X (X × Final)
              (fst X Final)
              ((pointAt X c) ∘ snd X Final))))
        (sub2 (X × Final) X X R
          (v0 X Final)
          ((fst X Final) ∘ ((pointAt X c) ∘ snd X Final)))
        (memAt X R c)
        (Forall_snd_pair_then_beta_right X X (X × Final) X X R
          (v0 X Final)
          (fst X Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final))
        (Forall_iffTrans_apply X
          (sub2 (X × Final) X X R
            (v0 X Final)
            ((fst X Final) ∘ ((pointAt X c) ∘ snd X Final)))
          (sub2 (X × Final) X X R
            (v0 X Final)
            ((Cart.weakening X Final c) ∘ snd X Final))
          (memAt X R c)
          (Forall_pointAt_fst_beta_right X X X R
            (v0 X Final)
            c
            (snd X Final))
          (Forall_const_comp_beta_right X X X Final R
            (v0 X Final)
            c
            (snd X Final)))))

noncomputable def Forall_exMemPhi_phiClean_from_product_basis (X : Type)
    (phi : Pred X) (c : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((phi ∘ (v0 X (X × Final)))
      ∘ (pair (X × Final) X (X × Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final)))
    (phi ∘ (v0 X Final)))) :=
  Forall_fst_pair_unary_beta X X (X × Final) phi
    (fst X Final)
    ((pointAt X c) ∘ snd X Final)

noncomputable def Forall_exMemPhiClean_from_product_basis (X : Type)
    (R : Pred (X × X)) (phi : Pred X) (c : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((Pred.and (X × (X × Final))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
       (phi ∘ (v0 X (X × Final))))
     ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final)))
    (Pred.and (X × Final)
      (memAt X R c)
      (phi ∘ (v0 X Final))))) :=
  Forall_iffTrans_apply X
    ((Pred.and (X × (X × Final))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
       (phi ∘ (v0 X (X × Final))))
     ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final)))
    (Pred.and (X × Final)
      ((sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
        ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final)))
      ((phi ∘ (v0 X (X × Final)))
        ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final))))
    (Pred.and (X × Final)
      (memAt X R c)
      (phi ∘ (v0 X Final)))
    (Forall_and_reindex_beta X (X × (X × Final))
      (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final))
