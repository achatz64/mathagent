        (Forall_andCong X
          ((sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
            ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final)))
          (memAt X R c)
          ((phi ∘ (v0 X (X × Final)))
            ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final)))
