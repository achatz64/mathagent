import classical_first_order_logic_new
import beta_basis

-- Definite description ("the" / ι operator) in the UNIFORM-ATOM discipline.
--
-- A described object is a SET, pinned down by its members.  Everything is built from
-- ONE membership atom `elt : Pred (X × X)` ("w ∈ s"); set-equality is DERIVED from it
-- (SetEq(c,d) := ∀w. w∈c ↔ w∈d), and a set is characterized by a condition on its
-- elements `phi : Pred X` :  c is the unique set with  ∀w. (w∈c ↔ phi w).
--
-- Why "uniform atom": the earlier design composed opaque closed predicates onto
-- projections (`E ∘ proj`, `P ∘ proj`), so the same fact "w∈a" got two non-defeq
-- representations (via `isEmpty` vs via `SetEq`) that `=`-free code cannot merge.
-- Here `w∈c`, `w∈d`, `phi w` and SetEq are ALL built once, from `elt`, via v0/v1 in a
-- single de-Bruijn context — so the uniqueness body is DEFINITIONALLY `charUnique_ctx`'s
-- conclusion.  Uniqueness then needs no reindexing: it is proved once, generically,
-- for every characterized set (`uniqueOf` below).

-- ===== the membership atom, applied in each context =====

-- w ∈ (the ∃-witness set), at the single-set context (w, (c, ⋆)) : X × (X × Final).
noncomputable def memWit (X : Type) (elt : Pred (X × X)) : Pred (X × (X × Final)) :=
  sub2 (X × (X × Final)) X X elt (v0 X (X × Final)) (v1 X X Final)

-- w ∈ (a TERM s), at the single-set context (w, ⋆) : X × Final.
noncomputable def memAt (X : Type) (elt : Pred (X × X)) (s : X) : Pred (X × Final) :=
  sub2 (X × Final) X X elt (v0 X Final) (Cart.weakening X (X × Final) s)

-- w ∈ c  and  w ∈ d, at the uniqueness context (w, ((c,d), ⋆)) : X × ((X×X) × Final).
noncomputable def memFst (X : Type) (elt : Pred (X × X)) : Pred (X × ((X × X) × Final)) :=
  sub2 (X × ((X × X) × Final)) X X elt (v0 X ((X × X) × Final))
    (fst X X ∘ (fst (X × X) Final ∘ snd X ((X × X) × Final)))
noncomputable def memSnd (X : Type) (elt : Pred (X × X)) : Pred (X × ((X × X) × Final)) :=
  sub2 (X × ((X × X) × Final)) X X elt (v0 X ((X × X) × Final))
    (snd X X ∘ (fst (X × X) Final ∘ snd X ((X × X) × Final)))

-- ===== the characterization body, and how it is reindexed between contexts =====
--
-- The characterization `cbody : Pred (X × (X × Final))` is given at the EXISTENCE context
-- (w, (c, ⋆)) — exactly the shape of set.cor's ZFC-axiom bodies — so existence matches by
-- defeq with no bridge.  For uniqueness it is reindexed opaquely into the (c,d) context
-- (charUnique_ctx never inspects it); for the spec the set slot is substituted by a term.

-- reindex the characterization into the uniqueness (pair) context (w, ((c,d), ⋆)),
-- reading the set slot off the FIRST component c of the pair.
noncomputable def cmap (X : Type) : X × ((X × X) × Final) -> X × (X × Final) :=
  pair (X × ((X × X) × Final)) X (X × Final)
    (v0 X ((X × X) × Final))
    (pair (X × ((X × X) × Final)) X Final
      (fst X X ∘ (fst (X × X) Final ∘ snd X ((X × X) × Final)))
      (snd (X × X) Final ∘ snd X ((X × X) × Final)))

-- substitute a concrete set s into the characterization:  (w, ⋆) ↦ (w, (s, ⋆)).
noncomputable def smap (X : Type) (s : X) : X × Final -> X × (X × Final) :=
  pair (X × Final) X (X × Final)
    (v0 X Final)
    (pair (X × Final) X Final (Cart.weakening X (X × Final) s) (snd X Final))

-- hasChar s : "s is characterized by cbody" — ∀w. (w∈s ↔ cbody[c:=s]).  A closed PC.
noncomputable def hasChar (X : Type) (elt : Pred (X × X)) (cbody : Pred (X × (X × Final)))
    (s : X) : PC :=
  Pred.term (Forall X Final (Pred.iff (X × Final) (memAt X elt s) (cbody ∘ smap X s)))

-- existence half: ∃c. ∀w. (w∈c ↔ cbody).  Defeq to set.cor's axiom for the matching cbody.
noncomputable def existsChar (X : Type) (elt : Pred (X × X)) (cbody : Pred (X × (X × Final))) : PC :=
  Pred.term (Exist X Final
    (Forall X (X × Final) (Pred.iff (X × (X × Final)) (memWit X elt) cbody)))

-- ===== uniqueness, built inline so it IS charUnique_ctx's conclusion =====

-- ∀(c,d). (∀w. w∈c ↔ cbody) → (∀w. w∈d ↔ cbody) → (∀w. w∈c ↔ w∈d).
noncomputable def Unique (X : Type) (elt : Pred (X × X)) (cbody : Pred (X × (X × Final))) :
    Pred Final :=
  Forall (X × X) Final
    (Pred.imply ((X × X) × Final)
      (Forall X ((X × X) × Final)
        (Pred.iff (X × ((X × X) × Final)) (memFst X elt) (cbody ∘ cmap X)))
      (Pred.imply ((X × X) × Final)
        (Forall X ((X × X) × Final)
          (Pred.iff (X × ((X × X) × Final)) (memSnd X elt) (cbody ∘ cmap X)))
        (Forall X ((X × X) × Final)
          (Pred.iff (X × ((X × X) × Final)) (memFst X elt) (memSnd X elt)))))

-- uniqueness is proved ONCE, generically, for every characterized set: the inline body
-- above is definitionally charUnique_ctx's conclusion (A := w∈c, B := w∈d, C := cbody).
noncomputable def uniqueOf (X : Type) (elt : Pred (X × X)) (cbody : Pred (X × (X × Final))) :
    Pred.term (Unique X elt cbody) :=
  charUnique_ctx X (X × X) (memFst X elt) (memSnd X elt) (cbody ∘ cmap X)

-- unique existence.
noncomputable def ExistUnique (X : Type) (elt : Pred (X × X)) (cbody : Pred (X × (X × Final))) : PC :=
  and (existsChar X elt cbody) (Pred.term (Unique X elt cbody))

-- ===== the description operator =====

-- from unique existence, extract the witness (the Prop → Type bridge the axioms lack).
axiom the (X : Type) (elt : Pred (X × X)) (cbody : Pred (X × (X × Final))) :
  ExistUnique X elt cbody -> X

-- spec: the described set is characterized by cbody.
axiom the_spec (X : Type) (elt : Pred (X × X)) (cbody : Pred (X × (X × Final)))
  (h : ExistUnique X elt cbody) : hasChar X elt cbody (the X elt cbody h)

-- ===== the ¬-characterization path (empty set):  ∀w. ¬(w∈c) =====
--
-- Empty is not an "↔ φ" characterization, so it rides emptyUniqueCore_ctx rather than
-- charUnique_ctx.  Existence and spec stay in the CLOSED form `Forall X X (¬elt)` (which
-- is exactly `isEmpty` when elt := Elem), so they match set.cor's `empty_ax` with no
-- change to set.cor; only the uniqueness proof bridges closed→inline via Forall_reindex.

-- the closed "s is empty" predicate:  ∀w. ¬(w∈s).   (= isEmpty when elt := Elem.)
noncomputable def emptyPred (X : Type) (elt : Pred (X × X)) : Pred X :=
  Forall X X (Pred.not (X × X) elt)

-- existence:  ∃c. ∀w. ¬(w∈c).   (defeq to set.cor's empty_ax.)
noncomputable def existsCharNeg (X : Type) (elt : Pred (X × X)) : PC :=
  Pred.term (Exist X Final (emptyPred X elt ∘ (v0 X Final)))

-- spec target: the described set is empty.
noncomputable def hasCharNeg (X : Type) (elt : Pred (X × X)) (s : X) : PC :=
  emptyPred X elt s

-- uniqueness:  ∀(c,d). (∀w.¬(w∈c)) → (∀w.¬(w∈d)) → (∀w. w∈c ↔ w∈d).  Antecedents CLOSED
-- (emptyPred ∘ proj, matching existence); conclusion the inline SetEq derived from elt.
noncomputable def UniqueNeg (X : Type) (elt : Pred (X × X)) : Pred Final :=
  Forall (X × X) Final
    (Pred.imply ((X × X) × Final)
      (emptyPred X elt ∘ (fst X X ∘ fst (X × X) Final))
      (Pred.imply ((X × X) × Final)
        (emptyPred X elt ∘ (snd X X ∘ fst (X × X) Final))
        (Forall X ((X × X) × Final)
          (Pred.iff (X × ((X × X) × Final)) (memFst X elt) (memSnd X elt)))))

-- proved generically: bridge each closed antecedent to its inline ∀w-form (Forall_reindex,
-- forward via Forall_iffMp), run emptyUniqueCore_ctx, assemble with Forall_bicompose.
noncomputable def uniqueOfNeg (X : Type) (elt : Pred (X × X)) :
    Pred.term (UniqueNeg X elt) :=
  Forall_bicompose (X × X)
    (emptyPred X elt ∘ (fst X X ∘ fst (X × X) Final))
    (emptyPred X elt ∘ (snd X X ∘ fst (X × X) Final))
    (Forall X ((X × X) × Final) (Pred.not (X × ((X × X) × Final)) (memFst X elt)))
    (Forall X ((X × X) × Final) (Pred.not (X × ((X × X) × Final)) (memSnd X elt)))
    (Forall X ((X × X) × Final) (Pred.iff (X × ((X × X) × Final)) (memFst X elt) (memSnd X elt)))
    (Forall_iffMp (X × X) _ _
      (Forall_reindex X X (X × X) (Pred.not (X × X) elt) (fst X X)))
    (Forall_iffMp (X × X) _ _
      (Forall_reindex X X (X × X) (Pred.not (X × X) elt) (snd X X)))
    (emptyUniqueCore_ctx X (X × X) (memFst X elt) (memSnd X elt))

noncomputable def ExistUniqueNeg (X : Type) (elt : Pred (X × X)) : PC :=
  and (existsCharNeg X elt) (Pred.term (UniqueNeg X elt))

axiom theNeg (X : Type) (elt : Pred (X × X)) : ExistUniqueNeg X elt -> X
axiom theNeg_spec (X : Type) (elt : Pred (X × X))
  (h : ExistUniqueNeg X elt) : hasCharNeg X elt (theNeg X elt h)

-- ===== consuming a spec at a point (for the elementary membership lemmas) =====
-- (the point substitution `pointAt` now lives in beta_basis.cor, next to the
--  point-level β-basis that observes at it.)

-- instantiate a `hasChar` spec at a point t: from ∀w.(w∈s ↔ cbody[c:=s]) read off the
-- single biconditional at w := t (Forall_elim, then split the iff with term_and/term_imply).
noncomputable def hasChar_at (X : Type) (elt : Pred (X × X)) (cbody : Pred (X × (X × Final)))
    (s : X) (h : hasChar X elt cbody s) (t : X) :
    iff (Pred.term ((memAt X elt s) ∘ pointAt X t))
        (Pred.term ((cbody ∘ smap X s) ∘ pointAt X t)) :=
  iff_intro _ _
    (iff_mp _ _
      (term_imply (X × Final) (pointAt X t) (memAt X elt s) (cbody ∘ smap X s))
      (and_elim_left _ _
        (iff_mp _ _
          (term_and (X × Final) (pointAt X t)
            (Pred.imply (X × Final) (memAt X elt s) (cbody ∘ smap X s))
            (Pred.imply (X × Final) (cbody ∘ smap X s) (memAt X elt s)))
          (imply_elim _ _
            (Forall_elim X (Pred.iff (X × Final) (memAt X elt s) (cbody ∘ smap X s)) t) h))))
    (iff_mp _ _
      (term_imply (X × Final) (pointAt X t) (cbody ∘ smap X s) (memAt X elt s))
      (and_elim_right _ _
        (iff_mp _ _
          (term_and (X × Final) (pointAt X t)
            (Pred.imply (X × Final) (memAt X elt s) (cbody ∘ smap X s))
            (Pred.imply (X × Final) (cbody ∘ smap X s) (memAt X elt s)))
          (imply_elim _ _
            (Forall_elim X (Pred.iff (X × Final) (memAt X elt s) (cbody ∘ smap X s)) t) h))))

-- membership β: evaluating `w∈s` at the point w := t is the elementary `elt t s`.
-- MODEL: (memAt X elt s ∘ pointAt X t) ⋆ = elt (t, s) = curry⁻¹ … ; both sides elt (t,s).
-- DERIVED from the point-level β-basis (beta_basis.cor): open the atom with
-- beta_sub2_point, then clean the two argument slots (v0∘pointAt, weakening∘pointAt).
noncomputable def memBeta (X : Type) (elt : Pred (X × X)) (t s : X) :
  iff (Pred.term ((memAt X elt s) ∘ pointAt X t)) (curry X X PC elt t s) :=
  iff_trans _ _ _
    (beta_sub2_point (X × Final) X X elt
      (v0 X Final)
      (Cart.weakening X (X × Final) s)
      (pointAt X t))
    (iff_trans _ _ _
      (beta_v0_point_arg1 X X (curry X X PC elt) t
        (Final.term X ((Cart.weakening X (X × Final) s) ∘ pointAt X t)))
      (beta_weakening_arg2 X X (X × Final) (curry X X PC elt) t s (pointAt X t)))

-- reversed-slot membership β: the atom `z ∈ w` (fixed member z, bound container w — the second
-- conjunct of a union body), evaluated at the point w := t, is the elementary `elt z t`.
-- MODEL: (sub2 elt (const z)(v0) ∘ pointAt X t) ⋆ = elt (z, t); both sides elt (z,t).  Companion
-- to memBeta for the other argument slot; needed for ∃-witness bodies where the bound variable is
-- the container.
-- DERIVED from the point-level β-basis, mirror-image of memBeta's derivation.
noncomputable def memBetaRev (X : Type) (elt : Pred (X × X)) (z t : X) :
  iff (Pred.term
        ((sub2 (X × Final) X X elt (Cart.weakening X (X × Final) z) (v0 X Final)) ∘ pointAt X t))
      (curry X X PC elt z t) :=
  iff_trans _ _ _
    (beta_sub2_point (X × Final) X X elt
      (Cart.weakening X (X × Final) z)
      (v0 X Final)
      (pointAt X t))
    (iff_trans _ _ _
      (beta_weakening_arg1 X X (X × Final) (curry X X PC elt) z
        (Final.term X ((v0 X Final) ∘ pointAt X t))
        (pointAt X t))
      (beta_v0_point_arg2 X X (curry X X PC elt) z t))

-- both-constant atom β: an atom with BOTH slots fixed constants (neither is the bound variable),
-- evaluated at any point, is the elementary `elt c d` — the point map reads nothing.  Arises when a
-- constant atom (e.g. `b∈z`) rides under a binder over a THIRD variable, as in the object-∀
-- extensionality `memCong_left_all`.  Companion to memBeta / memBetaRev for the case where the
-- bound variable occurs in NEITHER slot.  MODEL: (sub2 elt (const c)(const d) ∘ pointAt X t) ★ =
-- elt (c,d); both sides elt (c,d).
-- DERIVED from the point-level β-basis: open with beta_sub2_point, clean both constant slots.
noncomputable def constAtomBeta (X : Type) (elt : Pred (X × X)) (c d t : X) :
  iff (Pred.term
        ((sub2 (X × Final) X X elt (Cart.weakening X (X × Final) c) (Cart.weakening X (X × Final) d))
          ∘ pointAt X t))
      (curry X X PC elt c d) :=
  iff_trans _ _ _
    (beta_sub2_point (X × Final) X X elt
      (Cart.weakening X (X × Final) c)
      (Cart.weakening X (X × Final) d)
      (pointAt X t))
    (iff_trans _ _ _
      (beta_weakening_arg1 X X (X × Final) (curry X X PC elt) c
        (Final.term X ((Cart.weakening X (X × Final) d) ∘ pointAt X t))
        (pointAt X t))
      (beta_weakening_arg2 X X (X × Final) (curry X X PC elt) c d (pointAt X t)))

-- separation-φ β: the φ-slot of a Separation body, `phi ∘ v0`, evaluated at a point.  The maps
-- smap/pointAt build the context (t,(s,⋆)); v0 reads the tested element t back out, so the whole
-- composite is `phi t`.  MODEL: (phi∘v0)∘(smap s∘pointAt t) ⋆ = phi (v0 (t,(s,⋆))) = phi t; both
-- sides phi t.  NON-DERIVABLE from the current β-basis: needs a point-level fst∘pair observation
-- (the point sibling of Forall_fst_pair_unary_beta) to open v0∘smap — a candidate basis addition.
axiom sepPhiBeta (X : Type) (phi : Pred X) (s t : X) :
  iff (Pred.term ((phi ∘ (v0 X (X × Final))) ∘ (smap X s ∘ pointAt X t))) (phi t)

-- atom β: a characterization atom `R(w, c)` (R applied to the bound w and a constant c),
-- evaluated at the point (w,(·)) := (t, (s, ⋆)), is the elementary `R t c`.
-- MODEL: both sides are R (t, c).  NON-DERIVABLE from the current β-basis: beta_sub2_point opens
-- it, but the v0∘(smap∘pointAt) slot needs a point-level fst∘pair observation (candidate addition).
axiom atomBeta (X : Type) (R : Pred (X × X)) (s c t : X) :
  iff (Pred.term
        ((sub2 (X × (X × Final)) X X R (v0 X (X × Final))
           (Cart.weakening X (X × (X × Final)) c)) ∘ (smap X s ∘ pointAt X t)))
      (curry X X PC R t c)

-- ===== ∀-lifted atom β (the binder-level companion of atomBeta) =====
-- atomBeta cleans a smap-composed atom AT A POINT; this cleans it UNDER the ∀ binder (no point).
-- It is the same combinator β-law, uniform in the bound w, and is GENERIC IN R — it asserts nothing
-- about any particular relation or set, only that the opaque product plumbing (smap, v0, weakening)
-- reindexes the atom to its clean single-context form.  Two versions: a single atom, and the
-- `Pred.or` of two such atoms (the pair/successor characterization body shape).
-- MODEL: at (w,⋆) both sides are R(w,a) ∨ R(w,b); the s-slot is unused (a/b are weakened constants).
-- DERIVED from the binder-level β-basis: or-reindexing distributes smap into the two atoms,
-- each atom is cleaned by Forall_atomSmapClean below, and Forall_orCong reassembles.

-- single-atom smap cleaner: an atom `R(w, const a)` composed with smap s reindexes to the
-- clean single-context form.  MODEL: at (w,⋆) both sides are R(w,a); the s-slot is unused.
-- DERIVED: sub2-reindex opens the composition; the v0 slot is fst∘pair (Forall_fst_pair_beta_left
-- with smap's components), the constant slot is weakening∘smap (Forall_const_comp_beta_right).
noncomputable def Forall_atomSmapClean (X : Type) (R : Pred (X × X)) (a s : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((sub2 (X × (X × Final)) X X R
        (v0 X (X × Final))
        (Cart.weakening X (X × (X × Final)) a))
      ∘ smap X s)
    (sub2 (X × Final) X X R
      (v0 X Final)
      (Cart.weakening X (X × Final) a)))) :=
  Forall_iffTrans_apply X
    ((sub2 (X × (X × Final)) X X R
        (v0 X (X × Final))
        (Cart.weakening X (X × (X × Final)) a))
      ∘ smap X s)
    (sub2 (X × Final) X X R
      ((v0 X (X × Final)) ∘ smap X s)
      ((Cart.weakening X (X × (X × Final)) a) ∘ smap X s))
    (sub2 (X × Final) X X R
      (v0 X Final)
      (Cart.weakening X (X × Final) a))
    (Forall_sub2_reindex_beta X (X × (X × Final)) X X R
      (v0 X (X × Final))
      (Cart.weakening X (X × (X × Final)) a)
      (smap X s))
    (Forall_iffTrans_apply X
      (sub2 (X × Final) X X R
        ((v0 X (X × Final)) ∘ smap X s)
        ((Cart.weakening X (X × (X × Final)) a) ∘ smap X s))
      (sub2 (X × Final) X X R
        (v0 X Final)
        ((Cart.weakening X (X × (X × Final)) a) ∘ smap X s))
      (sub2 (X × Final) X X R
        (v0 X Final)
        (Cart.weakening X (X × Final) a))
      (Forall_fst_pair_beta_left X X (X × Final) X R
        (v0 X Final)
        (pair (X × Final) X Final
          (Cart.weakening X (X × Final) s)
          (snd X Final))
        ((Cart.weakening X (X × (X × Final)) a) ∘ smap X s))
      (Forall_const_comp_beta_right X X X (X × (X × Final)) R
        (v0 X Final)
        a
        (smap X s)))

noncomputable def Forall_orAtomsClean (X : Type) (R : Pred (X × X)) (a b s : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((Pred.or (X × (X × Final))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) a))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) b)))
     ∘ smap X s)
    (Pred.or (X × Final)
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) a))
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) b))))) :=
  Forall_iffTrans_apply X
    ((Pred.or (X × (X × Final))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) a))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (Cart.weakening X (X × (X × Final)) b)))
     ∘ smap X s)
    (Pred.or (X × Final)
      ((sub2 (X × (X × Final)) X X R
          (v0 X (X × Final))
          (Cart.weakening X (X × (X × Final)) a))
        ∘ smap X s)
      ((sub2 (X × (X × Final)) X X R
          (v0 X (X × Final))
          (Cart.weakening X (X × (X × Final)) b))
        ∘ smap X s))
    (Pred.or (X × Final)
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) a))
      (sub2 (X × Final) X X R (v0 X Final) (Cart.weakening X (X × Final) b)))
    (Forall_or_reindex_beta X (X × (X × Final)) (smap X s)
      (sub2 (X × (X × Final)) X X R
        (v0 X (X × Final))
        (Cart.weakening X (X × (X × Final)) a))
      (sub2 (X × (X × Final)) X X R
        (v0 X (X × Final))
        (Cart.weakening X (X × (X × Final)) b)))
    (imply_elim _ _
      (imply_elim _ _
        (Forall_orCong X
          ((sub2 (X × (X × Final)) X X R
              (v0 X (X × Final))
              (Cart.weakening X (X × (X × Final)) a))
            ∘ smap X s)
          (sub2 (X × Final) X X R
            (v0 X Final)
            (Cart.weakening X (X × Final) a))
          ((sub2 (X × (X × Final)) X X R
              (v0 X (X × Final))
              (Cart.weakening X (X × (X × Final)) b))
            ∘ smap X s)
          (sub2 (X × Final) X X R
            (v0 X Final)
            (Cart.weakening X (X × Final) b)))
        (Forall_atomSmapClean X R a s))
      (Forall_atomSmapClean X R b s))

-- ∃-body cleaning (generic in R): clean the union inner body  (w∈A ∧ ·∈w)  composed with the
-- term_exist lift (which fills the tested-element slot with z and the set slot with U) to the clean
-- and-body  (w∈A ∧ z∈w).  Same β-law wall (opaque pair/fst/snd/smap), postulated at PC under ∀.
-- MODEL: at (w,⋆) both sides are R(w,A) ∧ R(z,w); U only fills the slot that is cleaned away.
axiom Forall_exUnionClean (X : Type) (R : Pred (X × X)) (A z U : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((Pred.and (X × (X × (X × Final)))
       (sub2 (X × (X × (X × Final))) X X R
         (v0 X (X × (X × Final))) (Cart.weakening X (X × (X × (X × Final))) A))
       (sub2 (X × (X × (X × Final))) X X R
         (v1 X X (X × Final)) (v0 X (X × (X × Final)))))
     ∘ (pair (X × Final) X (X × (X × Final)) (fst X Final)
          ((smap X U ∘ pointAt X z) ∘ snd X Final)))
    (Pred.and (X × Final)
      (memAt X R A)
      (sub2 (X × Final) X X R (Cart.weakening X (X × Final) z) (v0 X Final)))))

-- ∃-body cleaning for the "∃e.(e∈I ∧ phi e)" shape (generic in R, phi, c) — the infinity/empty-witness
-- companion of Forall_exUnionClean.  After term_exist lifts `(Exist … (e∈I ∧ phi e)) ∘ pointAt c` to a
-- closed ∃, its body composed with the lift (which fills the container slot I with the constant c) is
-- cleaned to `(e∈c ∧ phi e)`.  MODEL: at (e,⋆) both sides are R(e,c) ∧ phi(e); the lift only fills the
-- slot cleaned away.
-- DERIVED from the binder-level β-basis: and-reindexing splits the composition, the membership
-- atom is cleaned slot by slot (atomClean below), the φ-slot by fst∘pair (phiClean below), and
-- Forall_andCong reassembles.

-- the membership-atom half:  R(v0,v1) ∘ (pair fst (pointAt c ∘ snd))  cleans to  memAt R c.
noncomputable def Forall_exMemPhi_atomClean (X : Type) (R : Pred (X × X)) (c : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
      ∘ (pair (X × Final) X (X × Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final)))
    (memAt X R c))) :=
  Forall_iffTrans_apply X
    ((sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
      ∘ (pair (X × Final) X (X × Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final)))
    (sub2 (X × Final) X X R
      ((v0 X (X × Final)) ∘ (pair (X × Final) X (X × Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final)))
      ((v1 X X Final) ∘ (pair (X × Final) X (X × Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final))))
    (memAt X R c)
    (Forall_sub2_reindex_beta X (X × (X × Final)) X X R
      (v0 X (X × Final))
      (v1 X X Final)
      (pair (X × Final) X (X × Final)
        (fst X Final)
        ((pointAt X c) ∘ snd X Final)))
    (Forall_iffTrans_apply X
      (sub2 (X × Final) X X R
        ((v0 X (X × Final)) ∘ (pair (X × Final) X (X × Final)
            (fst X Final)
            ((pointAt X c) ∘ snd X Final)))
        ((v1 X X Final) ∘ (pair (X × Final) X (X × Final)
            (fst X Final)
            ((pointAt X c) ∘ snd X Final))))
      (sub2 (X × Final) X X R
        (v0 X Final)
        ((v1 X X Final) ∘ (pair (X × Final) X (X × Final)
            (fst X Final)
            ((pointAt X c) ∘ snd X Final))))
      (memAt X R c)
      (Forall_fst_pair_beta_left X X (X × Final) X R
        (fst X Final)
        ((pointAt X c) ∘ snd X Final)
        ((v1 X X Final) ∘ (pair (X × Final) X (X × Final)
            (fst X Final)
            ((pointAt X c) ∘ snd X Final))))
      (Forall_iffTrans_apply X
        (sub2 (X × Final) X X R
          (v0 X Final)
          ((v1 X X Final) ∘ (pair (X × Final) X (X × Final)
              (fst X Final)
              ((pointAt X c) ∘ snd X Final))))
        (sub2 (X × Final) X X R
          (v0 X Final)
          ((fst X Final) ∘ ((pointAt X c) ∘ snd X Final)))
        (memAt X R c)
        (Forall_snd_pair_then_beta_right X X (X × Final) X X R
          (v0 X Final)
          (fst X Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final))
        (Forall_iffTrans_apply X
          (sub2 (X × Final) X X R
            (v0 X Final)
            ((fst X Final) ∘ ((pointAt X c) ∘ snd X Final)))
          (sub2 (X × Final) X X R
            (v0 X Final)
            ((Cart.weakening X Final c) ∘ snd X Final))
          (memAt X R c)
          (Forall_pointAt_fst_beta_right X X X R
            (v0 X Final)
            c
            (snd X Final))
          (Forall_const_comp_beta_right X X X Final R
            (v0 X Final)
            c
            (snd X Final)))))

-- the φ-slot half:  (phi ∘ v0) ∘ (pair fst (pointAt c ∘ snd))  cleans to  phi ∘ v0.
noncomputable def Forall_exMemPhi_phiClean (X : Type) (phi : Pred X) (c : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((phi ∘ (v0 X (X × Final)))
      ∘ (pair (X × Final) X (X × Final)
          (fst X Final)
          ((pointAt X c) ∘ snd X Final)))
    (phi ∘ (v0 X Final)))) :=
  Forall_fst_pair_unary_beta X X (X × Final) phi
    (fst X Final)
    ((pointAt X c) ∘ snd X Final)

noncomputable def Forall_exMemPhiClean (X : Type) (R : Pred (X × X)) (phi : Pred X) (c : X) :
  Pred.term (Forall X Final (Pred.iff (X × Final)
    ((Pred.and (X × (X × Final))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
       (phi ∘ (v0 X (X × Final))))
     ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final)))
    (Pred.and (X × Final)
      (memAt X R c)
      (phi ∘ (v0 X Final))))) :=
  Forall_iffTrans_apply X
    ((Pred.and (X × (X × Final))
       (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
       (phi ∘ (v0 X (X × Final))))
     ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final)))
    (Pred.and (X × Final)
      ((sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
        ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final)))
      ((phi ∘ (v0 X (X × Final)))
        ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final))))
    (Pred.and (X × Final)
      (memAt X R c)
      (phi ∘ (v0 X Final)))
    (Forall_and_reindex_beta X (X × (X × Final))
      (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final))
      (sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
      (phi ∘ (v0 X (X × Final))))
    (imply_elim _ _
      (imply_elim _ _
        (Forall_andCong X
          ((sub2 (X × (X × Final)) X X R (v0 X (X × Final)) (v1 X X Final))
            ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final)))
          (memAt X R c)
          ((phi ∘ (v0 X (X × Final)))
            ∘ (pair (X × Final) X (X × Final) (fst X Final) ((pointAt X c) ∘ snd X Final)))
          (phi ∘ (v0 X Final)))
        (Forall_exMemPhi_atomClean X R c))
      (Forall_exMemPhi_phiClean X phi c))

