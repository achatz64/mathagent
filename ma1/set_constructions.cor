import set
import definite_description
import cartesian_combinators
import set_equality

-- Set constructions as TERMS via the description operator, in the uniform-atom discipline.
-- No axioms live in this file: existence comes from set.cor's ZFC axioms, uniqueness from
-- definite_description's generic `uniqueOf` / `uniqueOfNeg`, and each construction is a
-- proved `def`.

-- ===== Empty set:  the unique c with ∀w. ¬(w∈c)  (the ¬-characterization path) =====
--
-- existence is set.cor's `empty_ax` (defeq: emptyPred Sets Elem ≡ isEmpty), uniqueness is
-- `uniqueOfNeg` (emptyUniqueCore_ctx, bridged closed→inline by Forall_reindex).
noncomputable def emptyExU : ExistUniqueNeg Sets Elem :=
  and_intro (existsCharNeg Sets Elem) (Pred.term (UniqueNeg Sets Elem))
    empty_ax (uniqueOfNeg Sets Elem)

noncomputable def emptyset : Sets := theNeg Sets Elem emptyExU
noncomputable def emptyset_spec : isEmpty emptyset := theNeg_spec Sets Elem emptyExU

-- ===== Pairing:  {a,b} = the unique c with ∀w. (w∈c ↔ w=a ∨ w=b)  (↔-path) =====
--
-- pairBody is EXACTLY set.cor's pairing-axiom body, so existence is `pairing a b` by defeq;
-- uniqueness is the generic `uniqueOf` (charUnique_ctx, cbody opaque).
noncomputable def pairBody (a b : Sets) : Pred (Sets × (Sets × Final)) :=
  Pred.or (Sets × (Sets × Final))
    (sub2 (Sets × (Sets × Final)) Sets Sets SetEq (v0 Sets (Sets × Final))
      (Cart.weakening Sets (Sets × (Sets × Final)) a))
    (sub2 (Sets × (Sets × Final)) Sets Sets SetEq (v0 Sets (Sets × Final))
      (Cart.weakening Sets (Sets × (Sets × Final)) b))

noncomputable def pairExU (a b : Sets) : ExistUnique Sets Elem (pairBody a b) :=
  and_intro (existsChar Sets Elem (pairBody a b)) (Pred.term (Unique Sets Elem (pairBody a b)))
    (pairing a b) (uniqueOf Sets Elem (pairBody a b))

noncomputable def upair (a b : Sets) : Sets := the Sets Elem (pairBody a b) (pairExU a b)
noncomputable def pair_spec (a b : Sets) : hasChar Sets Elem (pairBody a b) (upair a b) :=
  the_spec Sets Elem (pairBody a b) (pairExU a b)

-- a ∈ {a,b} : instantiate pair_spec at w:=a, take the left disjunct (a = a).
noncomputable def pair_left (a b : Sets) : elem a (upair a b) :=
  iff_mp _ _ (curry_uncurry Sets Sets elem a (upair a b))
    (iff_mp _ _ (memBeta Sets Elem a (upair a b))
      (iff_mpr _ _ (hasChar_at Sets Elem (pairBody a b) (upair a b) (pair_spec a b) a)
        (iff_mpr _ _
          (term_or (Sets × (Sets × Final)) (smap Sets (upair a b) ∘ pointAt Sets a)
            (sub2 (Sets × (Sets × Final)) Sets Sets SetEq (v0 Sets (Sets × Final))
              (Cart.weakening Sets (Sets × (Sets × Final)) a))
            (sub2 (Sets × (Sets × Final)) Sets Sets SetEq (v0 Sets (Sets × Final))
              (Cart.weakening Sets (Sets × (Sets × Final)) b)))
          (or_intro_left _ _
            (iff_mpr _ _ (atomBeta Sets SetEq (upair a b) a a) (SetEq_refl a))))))

-- b ∈ {a,b} : instantiate pair_spec at w:=b, take the right disjunct (b = b).
noncomputable def pair_right (a b : Sets) : elem b (upair a b) :=
  iff_mp _ _ (curry_uncurry Sets Sets elem b (upair a b))
    (iff_mp _ _ (memBeta Sets Elem b (upair a b))
      (iff_mpr _ _ (hasChar_at Sets Elem (pairBody a b) (upair a b) (pair_spec a b) b)
        (iff_mpr _ _
          (term_or (Sets × (Sets × Final)) (smap Sets (upair a b) ∘ pointAt Sets b)
            (sub2 (Sets × (Sets × Final)) Sets Sets SetEq (v0 Sets (Sets × Final))
              (Cart.weakening Sets (Sets × (Sets × Final)) a))
            (sub2 (Sets × (Sets × Final)) Sets Sets SetEq (v0 Sets (Sets × Final))
              (Cart.weakening Sets (Sets × (Sets × Final)) b)))
          (or_intro_right _ _
            (iff_mpr _ _ (atomBeta Sets SetEq (upair a b) b b) (SetEq_refl b))))))

-- SetEq_sym / SetEq_trans / mem_subst now live in set_equality.cor (DERIVED from SetEq's
-- extensional definition), and are available here through `import set_equality`.

#check emptyset
#check emptyset_spec
#check upair
#check pair_spec
#check pair_left
#check pair_right
