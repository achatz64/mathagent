+/-- FT IV §4: the stabilizer of the slot of `γ` — order 8, a Sylow 2-subgroup of `S₄`. -/
+def quarticStabilizerGamma : Subgroup (Equiv.Perm (Fin 4)) :=
+  @MulAction.stabilizer (Equiv.Perm (Fin 4)) (Fin 3) _ quarticSlotAction 2
