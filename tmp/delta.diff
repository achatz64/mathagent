+/-- FT IV §4: the orbit of each slot under `S₄` is all of `{α, β, γ}`. -/
+theorem quarticOrbitAlpha_univ :
+    MulAction.orbit (Equiv.Perm (Fin 4)) (0 : Fin 3) = Set.univ := by
+  ext y
+  rw [MulAction.mem_orbit_iff]
