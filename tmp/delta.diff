+  · constructor
+    · intro _; trivial
+    · intro _; exact ⟨1, rfl⟩
+  · constructor
+    · intro _; trivial
+    · intro _; exact ⟨Equiv.swap 1 2, quarticPsi_swap12_zero⟩
+  · constructor
+    · intro _; trivial
+    · intro _; exact ⟨Equiv.swap 0 2, quarticPsi_swap02_zero⟩
