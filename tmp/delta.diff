+        ↥(IntermediateField.adjoin ℚ (f.rootSet ℂ)) := hr ▸ (⟨i, rfl⟩ : r i ∈ Set.range r)
+    have hae : aeval (r i) (f.map (algebraMap ℚ ↥(IntermediateField.adjoin ℚ (f.rootSet ℂ)))) = 0 :=
