+      · exact absurd h (by decide)
+      · exact h3
+      · exact absurd h (by decide)
+      · exact absurd h (by decide)
+    exact (quarticKlein_eq σ).mpr (Or.inr (Or.inr (Or.inr (Equiv.ext fun i => by
+      fin_cases i <;> simp [h0, h1, h2, h3]))))
